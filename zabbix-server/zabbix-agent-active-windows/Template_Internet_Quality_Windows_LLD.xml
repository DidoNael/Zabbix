                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>internet.ping.latency[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>F63100</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>internet.ping.jitter[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>4b0ddc392a494b10bd044cc968ff99d9</uuid>
                            <name>Ping - Perda de Pacotes: {#TARGET}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>F63100</color>
                                    <drawtype>FILLED_REGION</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>internet.ping.loss[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 2: HTTP -->
                <discovery_rule>
                    <uuid>d1b56c4fe1aa428d811c43c60dbc0512</uuid>
                    <name>Descoberta de Sites HTTP</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.http["{$HTTP_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre sites a partir da macro {$HTTP_TARGETS} (URLs separadas por virgula). Script: discover_http.ps1</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>8f55347076da4a38a4aeeae2009def27</uuid>
                            <name>HTTP - Tempo de Resposta {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.time[{#URL}]</key>
                            <delay>2m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Tempo de resposta HTTP para {#URL}. Script: site_http.ps1</description>
                            <tags>
                                <tag><tag>component</tag><value>http</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>040c3865cdbb42b5ba0b58018929f94f</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/site.http.time[{#URL}])&gt;{$HTTP_WARN_MS} and last(/Template Internet Quality Windows LLD - Netstream/site.http.status[{#URL}])&gt;0</expression>
                                    <name>Site lento - {#HOST} acima de {$HTTP_WARN_MS}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Tempo de resposta HTTP de {#URL} acima de {$HTTP_WARN_MS}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>db8947e8904946a685aaab74cfed4e9a</uuid>
                            <name>HTTP - Status {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.status[{#URL}]</key>
                            <delay>2m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Codigo de status HTTP de {#URL}. 0=inacessivel, 200=OK.</description>
                            <valuemap>
                                <name>HTTP Status Code</name>
                            </valuemap>
                            <tags>
                                <tag><tag>component</tag><value>http</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>c121c02988794c6bb571f745e4b005b3</uuid>
                                    <expression>min(/Template Internet Quality Windows LLD - Netstream/site.http.status[{#URL}],#3)=0</expression>
                                    <name>Site INACESSIVEL - {#HOST}</name>
                                    <priority>DISASTER</priority>
                                    <description>Sem resposta HTTP de {#URL}. Site fora do ar ou sem conectividade.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>91e17cb1936b48c4bfbaae67177770bf</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/site.http.status[{#URL}])&gt;=400 and last(/Template Internet Quality Windows LLD - Netstream/site.http.status[{#URL}])&lt;&gt;0</expression>
                                    <name>Erro HTTP - {#HOST} status &gt;= 400</name>
                                    <priority>HIGH</priority>
                                    <description>{#URL} retornando erro HTTP (4xx/5xx).</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>1735510cc0424092a7350ad4ac3737c9</uuid>
                            <name>SSL - Dias para Expiracao {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.ssl_days[{#URL}]</key>
                            <delay>1h</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>days</units>
                            <description>Dias restantes ate expiracao do certificado SSL de {#URL}.</description>
                            <tags>
                                <tag><tag>component</tag><value>ssl</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>b1a2b78074d0454a8edd058f0a5a0709</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/site.http.ssl_days[{#URL}])&lt;{$SSL_HIGH_DAYS} and last(/Template Internet Quality Windows LLD - Netstream/site.http.ssl_days[{#URL}])&gt;=0</expression>
                                    <name>SSL expirando em menos de {$SSL_HIGH_DAYS} dias - {#HOST}</name>
                                    <priority>HIGH</priority>
                                    <description>Certificado SSL de {#URL} expira em menos de {$SSL_HIGH_DAYS} dias. Renovar URGENTE.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ssl</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>1de24cafb9404376aa994744cf559d39</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/site.http.ssl_days[{#URL}])&lt;{$SSL_WARN_DAYS} and last(/Template Internet Quality Windows LLD - Netstream/site.http.ssl_days[{#URL}])&gt;={$SSL_HIGH_DAYS}</expression>
                                    <name>SSL expirando em menos de {$SSL_WARN_DAYS} dias - {#HOST}</name>
                                    <priority>WARNING</priority>
                                    <description>Certificado SSL de {#URL} expira em menos de {$SSL_WARN_DAYS} dias.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ssl</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>49aaa056891a4e6b9e87c501fcca2c4f</uuid>
                            <name>HTTP - Tempo de Resposta: {#HOST}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>6C59DC</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>site.http.time[{#URL}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 3: TRACERT -->
                <discovery_rule>
                    <uuid>730e5bd194ac4fe8bbb8b15480912b44</uuid>
                    <name>Descoberta de Targets de Tracert</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.tracert["{$TRACERT_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de traceroute a partir da macro {$TRACERT_TARGETS}. Script: discover_tracert.ps1</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>588c124bdfeb417182408ffc2a5a76b2</uuid>
                            <name>Tracert - Numero de Hops {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.tracert.hops[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>hops</units>
                            <description>Numero de saltos na rota ate {#TARGET}. Script: tracert_check.ps1</description>
                            <tags>
                                <tag><tag>component</tag><value>tracert</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>83391439c3b94428b35322fa305ea34b</uuid>
                            <name>Tracert - RTT Ultimo Hop {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.tracert.last_rtt[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT do ultimo hop na rota ate {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>tracert</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>363b5f5ebace42dbb3c28a36041fcca6</uuid>
                            <name>Tracert - RTT Maximo {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.tracert.max_rtt[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT maximo entre todos os hops ate {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>tracert</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>9292a91fd3184f75b8e0b553ea8d3a22</uuid>
                            <name>Tracert - RTT: {#TARGET}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>2774A4</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>site.tracert.last_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>F63100</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>site.tracert.max_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 4: MTR -->
                <discovery_rule>
                    <uuid>83de815753504399887b2a72600cfeb5</uuid>
                    <name>Descoberta de Targets de MTR</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.mtr["{$MTR_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de MTR a partir da macro {$MTR_TARGETS}. ATENCAO: poucos targets - cada um demora 2-5 min. Script: discover_mtr.ps1</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>0f050e1e1ef3430bbcfe43bc84a5832e</uuid>
                            <name>MTR - RTT Medio {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.mtr.avg_rtt[{#TARGET}]</key>
                            <delay>15m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT medio ao destino via MTR simulado para {#TARGET}. Script: mtr_check.ps1</description>
                            <tags>
                                <tag><tag>component</tag><value>mtr</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>751adb5c533a4fcd9d63ee08a28833b2</uuid>
                            <name>MTR - Perda de Pacotes {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.mtr.loss[{#TARGET}]</key>
                            <delay>15m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <description>Perda de pacotes no destino via MTR para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>mtr</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>23eb980564424836a495a8f57d71915a</uuid>
                            <name>MTR - Relatorio Completo {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.mtr.report[{#TARGET}]</key>
                            <delay>15m</delay>
                            <history>30d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Relatorio MTR completo hop a hop para {#TARGET}. Formato identico ao mtr --report do Linux.</description>
                            <tags>
                                <tag><tag>component</tag><value>mtr</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>e12fea8c1a9042efad44a387e98af259</uuid>
                            <name>MTR - RTT e Perda: {#TARGET}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>A54F10</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>site.mtr.avg_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 5: DNS -->
                <discovery_rule>
                    <uuid>469acfaaa58b47378742114a7024f7ae</uuid>
                    <name>Descoberta de Combinacoes DNS</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.dns["{$DNS_TARGETS}","{$DNS_SERVERS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre combinacoes dominio x servidor DNS a partir de {$DNS_TARGETS} e {$DNS_SERVERS}. Produto cartesiano: cada dominio testado em cada servidor. Script: discover_dns.ps1</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>7d0c1cf080cf47a58d29b0f5a223a3bf</uuid>
                            <name>DNS - Resolucao {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Tempo de resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER}. Script: nslookup_check.ps1</description>
                            <tags>
                                <tag><tag>component</tag><value>dns</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>7767c0bc1aae4cebb98c128dbc6aaa2c</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}])&gt;{$DNS_WARN_MS} and last(/Template Internet Quality Windows LLD - Netstream/site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}])=1</expression>
                                    <name>DNS lento - {#DNS_SERVER} para {#DNS_DOMAIN} acima de {$DNS_WARN_MS}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER} acima de {$DNS_WARN_MS}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>dns</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>9347dfe467534f748446ec28963392f6</uuid>
                            <name>DNS - Status {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Status da resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER}. 1=OK, 0=Falhou.</description>
                            <valuemap>
                                <name>DNS Status</name>
                            </valuemap>
                            <tags>
                                <tag><tag>component</tag><value>dns</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>41a0e99e6540407bb28773b522fe803c</uuid>
                                    <expression>min(/Template Internet Quality Windows LLD - Netstream/site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}],#3)=0</expression>
                                    <name>DNS FALHOU - {#DNS_SERVER} nao resolveu {#DNS_DOMAIN}</name>
                                    <priority>HIGH</priority>
                                    <description>Falha na resolucao DNS de {#DNS_DOMAIN} via servidor {#DNS_SERVER}.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>dns</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>fef6e4c79df447258bb69e45cbfae187</uuid>
                            <name>DNS - Tempo de Resolucao: {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7C11</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Windows LLD - Netstream</host>
                                        <key>site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

            </discovery_rules>

        </template>
    </templates>

    <!-- Triggers de itens fixos ficam no nivel raiz do zabbix_export, nao dentro de <template> -->
    <triggers>
        <trigger>
            <uuid>c4109a98bb6243ca873261c7151d2d2f</uuid>
            <expression>last(/Template Internet Quality Windows LLD - Netstream/agent.ping)&lt;&gt;1</expression>
            <name>Agente Zabbix inativo</name>
            <priority>HIGH</priority>
            <description>O agente Zabbix nao esta respondendo. Verificar servico no Windows.</description>
            <manual_close>YES</manual_close>
            <tags>
                <tag><tag>component</tag><value>agent</value></tag>
            </tags>
        </trigger>
        <trigger>
            <uuid>fa311d145cad459299aaafe93f0dd594</uuid>
            <expression>last(/Template Internet Quality Windows LLD - Netstream/internet.speed.download)&lt;{$SPEED_MIN_DOWN} and last(/Template Internet Quality Windows LLD - Netstream/internet.speed.download)&gt;0</expression>
            <name>Download abaixo de {$SPEED_MIN_DOWN} Mbps</name>
            <priority>WARNING</priority>
            <description>Velocidade de download abaixo do minimo esperado ({$SPEED_MIN_DOWN} Mbps).</description>
            <tags>
                <tag><tag>component</tag><value>speedtest</value></tag>
            </tags>
        </trigger>
    </triggers>

</zabbix_export>


