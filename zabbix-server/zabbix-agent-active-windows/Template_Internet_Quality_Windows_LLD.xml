                    <uuid>ad1bcc44cbfb4b4592c2f4effadd7317</uuid>
                    <name>Agent - Conectividade</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>agent.ping</key>
                    <delay>1m</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Verifica se o agente esta ativo. 1 = OK.</description>
                    <tags>
                        <tag><tag>component</tag><value>agent</value></tag>
                    </tags>
                </item>
                <item>
                    <uuid>95422af4525f4f5987618ddf8f9b5c56</uuid>
                    <name>Speedtest - Download</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>internet.speed.download</key>
                    <delay>15m</delay>
                    <value_type>FLOAT</value_type>
                    <units>Mbps</units>
                    <description>Velocidade de download via Speedtest CLI (Ookla).</description>
                    <tags>
                        <tag><tag>component</tag><value>speedtest</value></tag>
                    </tags>
                </item>
                <item>
                    <uuid>37a09913691940d4a1a3919510cbeea0</uuid>
                    <name>Speedtest - Upload</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>internet.speed.upload</key>
                    <delay>15m</delay>
                    <value_type>FLOAT</value_type>
                    <units>Mbps</units>
                    <description>Velocidade de upload via Speedtest CLI (Ookla).</description>
                    <tags>
                        <tag><tag>component</tag><value>speedtest</value></tag>
                    </tags>
                </item>
            </items>

            <discovery_rules>

                <!-- REGRA 1: PING -->
                <discovery_rule>
                    <uuid>6179138459094ee98bc058753352ecf7</uuid>
                    <name>Descoberta de Targets de Ping</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.ping["{$PING_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de ping a partir da macro {$PING_TARGETS} (separados por virgula). Script: discover_ping.ps1</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>fd11b354529f4d14b32232a8f528b0ab</uuid>
                            <name>Ping - Latencia {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.latency[{#TARGET}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Latencia media ICMP para {#TARGET}. Script: ping_check.ps1</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>af804924a83f40958d76de4a17233df0</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/internet.ping.latency[{#TARGET}])&gt;{$LATENCY_HIGH}</expression>
                                    <name>Latencia CRITICA - {#TARGET} acima de {$LATENCY_HIGH}ms</name>
                                    <priority>HIGH</priority>
                                    <description>Latencia ICMP para {#TARGET} acima de {$LATENCY_HIGH}ms.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>f776b153f7df4557ba29906ee4e57326</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/internet.ping.latency[{#TARGET}])&gt;{$LATENCY_WARN} and last(/Template Internet Quality Windows LLD - Netstream/internet.ping.latency[{#TARGET}])&lt;={$LATENCY_HIGH}</expression>
                                    <name>Alta latencia - {#TARGET} acima de {$LATENCY_WARN}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Latencia ICMP para {#TARGET} acima de {$LATENCY_WARN}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>6efc108273a94ccdb2617bdf05f949cd</uuid>
                            <name>Ping - Perda de Pacotes {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.loss[{#TARGET}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <description>Percentual de perda de pacotes ICMP para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>d222a42506e04072b069d8627f5b7fb9</uuid>
                                    <expression>min(/Template Internet Quality Windows LLD - Netstream/internet.ping.loss[{#TARGET}],#3)&gt;=100</expression>
                                    <name>Internet INACESSIVEL - {#TARGET} 100% perda</name>
                                    <priority>DISASTER</priority>
                                    <description>Perda de pacotes 100% para {#TARGET}. Destino completamente indisponivel.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>b0df6a5367f64cc081a773d1890cd56b</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/internet.ping.loss[{#TARGET}])&gt;{$LOSS_HIGH} and last(/Template Internet Quality Windows LLD - Netstream/internet.ping.loss[{#TARGET}])&lt;100</expression>
                                    <name>Alta perda de pacotes - {#TARGET} acima de {$LOSS_HIGH}%</name>
                                    <priority>HIGH</priority>
                                    <description>Perda de pacotes acima de {$LOSS_HIGH}% para {#TARGET}.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>472c38a28db549849fc5759519f6b660</uuid>
                                    <expression>last(/Template Internet Quality Windows LLD - Netstream/internet.ping.loss[{#TARGET}])&gt;{$LOSS_WARN} and last(/Template Internet Quality Windows LLD - Netstream/internet.ping.loss[{#TARGET}])&lt;={$LOSS_HIGH}</expression>
                                    <name>Perda de pacotes - {#TARGET} acima de {$LOSS_WARN}%</name>
                                    <priority>WARNING</priority>
                                    <description>Perda de pacotes acima de {$LOSS_WARN}% para {#TARGET}.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>8e07cf4342004742a6c508b7c88a7ac9</uuid>
                            <name>Ping - Jitter {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.jitter[{#TARGET}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Variacao de latencia (jitter) ICMP para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>8131946abcab41c5a7e341153f54554c</uuid>
