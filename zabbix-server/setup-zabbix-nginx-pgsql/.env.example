# ============================================================================
# .env.example — Variáveis da instalação padrão Zabbix (Nginx + PostgreSQL)
# ----------------------------------------------------------------------------
# NÃO edite as senhas aqui. Rode  ./gerar-senhas.sh  para criar o arquivo .env
# real com senhas fortes e ÚNICAS por servidor.
#
# NUNCA faça commit do arquivo .env (ele contém segredos). O .gitignore deste
# diretório já bloqueia o .env. Este .env.example é só referência.
# ============================================================================

# --- Banco de dados PostgreSQL (local) --------------------------------------
ZABBIX_DB_HOST=127.0.0.1
ZABBIX_DB_PORT=5432
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
# Senha do usuário do banco (preenchida por ./gerar-senhas.sh):
ZABBIX_DB_PASSWORD=

# --- Frontend / aplicação ---------------------------------------------------
# Senha sugerida para o usuário Admin do Zabbix (trocar no 1º login):
ZABBIX_ADMIN_PASSWORD=
# FQDN do servidor — vira o server_name do Nginx e o nome exibido no frontend:
ZABBIX_SERVER_NAME=zabbix.exemplo.com.br
# Porta HTTP do Nginx (use 80; habilite 443/TLS no hardening):
NGINX_LISTEN=80

# --- Ambiente ---------------------------------------------------------------
ZABBIX_TIMEZONE=America/Sao_Paulo

# --- Agente (zabbix-agent2 local) -------------------------------------------
# Chave PSK (hex) para cifrar a comunicação server <-> agent (opcional):
ZABBIX_AGENT_PSK=
ZABBIX_AGENT_PSK_IDENTITY=psk-zabbix-server
