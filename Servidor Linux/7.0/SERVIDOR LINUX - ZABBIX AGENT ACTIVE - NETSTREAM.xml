            <discovery_rules>
                <discovery_rule>
                    <uuid>a3f1c8e2d4b54a6f9e0c7d2b1a5e8f3c</uuid>
                    <name>Descoberta de filesystems</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>vfs.fs.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#FSTYPE}</macro>
                                <value>^(tmpfs|devtmpfs|sysfs|proc|udev|cgroup|cgroup2|overlay|squashfs|pstore|securityfs|debugfs|tracefs|mqueue|hugetlbfs|fusectl|configfs|autofs|ramfs)$</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                            <condition>
                                <macro>{#FSNAME}</macro>
                                <value>^(/run|/sys|/proc|/dev)(/|$)</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                                <formulaid>B</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_IMMEDIATELY</lifetime_type>
                    <lifetime>0</lifetime>
                    <enabled_lifetime_type>DISABLE_NEVER</enabled_lifetime_type>
