                            <description>Variacao de latencia (jitter) ICMP para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

