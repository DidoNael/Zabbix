                <!-- REGRA 3: TRACEROUTE -->
                <discovery_rule>
                    <uuid>4229a9d58c8b4c54ac6fe80cec2d3940</uuid>
                    <name>Descoberta de Targets de Traceroute</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.traceroute["{$TRACEROUTE_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de traceroute a partir da macro {$TRACEROUTE_TARGETS}. Script: discover_traceroute.sh</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>5f6584c9e9f54df89afc1dccaaafea57</uuid>
                            <name>Traceroute - Numero de Hops {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.traceroute.hops[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>hops</units>
                            <description>Numero de saltos na rota ate {#TARGET} via traceroute. Script: traceroute_check.sh</description>
                            <tags>
                                <tag><tag>component</tag><value>traceroute</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>d79db1155a8445c196cda3c22fcf2d6c</uuid>
                            <name>Traceroute - RTT Ultimo Hop {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.traceroute.last_rtt[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT do ultimo hop na rota ate {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>traceroute</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>e447f4ee67be478f86677edbdc4d8c68</uuid>
                            <name>Traceroute - RTT Maximo {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.traceroute.max_rtt[{#TARGET}]</key>
                            <delay>10m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT maximo entre todos os hops ate {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>traceroute</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>e5de56c1fed94549957590ce0d53cf16</uuid>
                            <name>Traceroute - RTT: {#TARGET}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>2774A4</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Linux LLD - Netstream</host>
                                        <key>site.traceroute.last_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>F63100</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Linux LLD - Netstream</host>
                                        <key>site.traceroute.max_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 4: MTR -->
                <discovery_rule>
                    <uuid>d6302eab5e7d4b6b8ec5306eee5ef012</uuid>
                    <name>Descoberta de Targets de MTR</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.mtr["{$MTR_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de MTR a partir da macro {$MTR_TARGETS}. ATENCAO: poucos targets - cada um demora 2-5 min. Script: discover_mtr.sh</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>a76b464205954f838cbdbfa54b3374eb</uuid>
                            <name>MTR - RTT Medio {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.mtr.avg_rtt[{#TARGET}]</key>
                            <delay>15m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>RTT medio ao destino via mtr para {#TARGET}. Script: mtr_check.sh</description>
                            <tags>
                                <tag><tag>component</tag><value>mtr</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>003ffeac9cea4b42bb80b45adcffdd5f</uuid>
                            <name>MTR - Perda de Pacotes {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.mtr.loss[{#TARGET}]</key>
                            <delay>15m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <description>Perda de pacotes no destino via mtr para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>mtr</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>8498d4b4b116445498506fd156683aee</uuid>
                            <name>MTR - RTT e Perda: {#TARGET}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>A54F10</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Linux LLD - Netstream</host>
                                        <key>site.mtr.avg_rtt[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 5: DNS -->
                <discovery_rule>
                    <uuid>c756d50dcd854db4b71b3eb037776b08</uuid>
                    <name>Descoberta de Combinacoes DNS</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.dns["{$DNS_TARGETS}","{$DNS_SERVERS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre combinacoes dominio x servidor DNS. Produto cartesiano: cada dominio testado em cada servidor. Script: discover_dns.sh</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>c44f8f7547064cbb906aa0286b93998f</uuid>
                            <name>DNS - Resolucao {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Tempo de resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER} usando dig. Script: dns_check.sh</description>
                            <tags>
                                <tag><tag>component</tag><value>dns</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>bd1982b3798b4a648bf081dd22f4d954</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}])&gt;{$DNS_WARN_MS} and last(/Template Internet Quality Linux LLD - Netstream/site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}])=1</expression>
                                    <name>DNS lento - {#DNS_SERVER} para {#DNS_DOMAIN} acima de {$DNS_WARN_MS}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER} acima de {$DNS_WARN_MS}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>dns</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>344e08ea31114f988a296dc39d066990</uuid>
                            <name>DNS - Status {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Status da resolucao DNS de {#DNS_DOMAIN} via {#DNS_SERVER}. 1=OK, 0=Falhou.</description>
                            <valuemap>
                                <name>DNS Status</name>
                            </valuemap>
                            <tags>
                                <tag><tag>component</tag><value>dns</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>a3434064ec88416289a8a940a32ee116</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.dns.status[{#DNS_DOMAIN},{#DNS_SERVER}])=0</expression>
                                    <name>DNS FALHOU - {#DNS_SERVER} nao resolveu {#DNS_DOMAIN}</name>
                                    <priority>HIGH</priority>
                                    <description>Falha na resolucao DNS de {#DNS_DOMAIN} via servidor {#DNS_SERVER}.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>dns</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>ad15fcbda17846598fafba22d58d3bb3</uuid>
                            <name>DNS - Tempo de Resolucao: {#DNS_DOMAIN} via {#DNS_SERVER}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7C11</color>
                                    <drawtype>BOLD_LINE</drawtype>
                                    <calc_fnc>AVG</calc_fnc>
                                    <item>
                                        <host>Template Internet Quality Linux LLD - Netstream</host>
                                        <key>site.dns.resolve_time[{#DNS_DOMAIN},{#DNS_SERVER}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

            </discovery_rules>

        </template>
    </templates>

    <triggers>
        <trigger>
            <uuid>aabde5cc94ca4fc6bb665180025bc670</uuid>
            <expression>last(/Template Internet Quality Linux LLD - Netstream/agent.ping)&lt;&gt;1</expression>
            <name>Agente Zabbix inativo</name>
            <priority>HIGH</priority>
            <description>O agente Zabbix nao esta respondendo. Verificar servico no Linux.</description>
            <manual_close>YES</manual_close>
            <tags>
                <tag><tag>component</tag><value>agent</value></tag>
            </tags>
        </trigger>
        <trigger>
            <uuid>0842b7c22b8440d29e5f0ae42a073563</uuid>
            <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.speed.download)&lt;{$SPEED_MIN_DOWN} and last(/Template Internet Quality Linux LLD - Netstream/internet.speed.download)&gt;0</expression>
            <name>Download abaixo de {$SPEED_MIN_DOWN} Mbps</name>
            <priority>WARNING</priority>
            <description>Velocidade de download abaixo do minimo esperado ({$SPEED_MIN_DOWN} Mbps).</description>
            <tags>
                <tag><tag>component</tag><value>speedtest</value></tag>
            </tags>
        </trigger>
    </triggers>

</zabbix_export>
