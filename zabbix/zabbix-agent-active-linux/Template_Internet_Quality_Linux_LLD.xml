                                    <item>
                                        <host>Template Internet Quality Linux LLD - Netstream</host>
                                        <key>internet.ping.loss[{#TARGET}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>

                <!-- REGRA 2: HTTP -->
                <discovery_rule>
                    <uuid>2e1693cc34064a84a66c5ed253ea1d74</uuid>
                    <name>Descoberta de Sites HTTP</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.http["{$HTTP_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre sites a partir da macro {$HTTP_TARGETS} (URLs separadas por virgula). Script: discover_http.sh</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>73eee01944504f10b92ba2a6947386a7</uuid>
                            <name>HTTP - Tempo de Resposta {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.time[{#URL}]</key>
                            <delay>2m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Tempo de resposta HTTP para {#URL} via curl. Script: site_http.sh</description>
                            <tags>
                                <tag><tag>component</tag><value>http</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>8db7293f257848ba94a6e23368dbe516</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.http.time[{#URL}])&gt;{$HTTP_WARN_MS} and last(/Template Internet Quality Linux LLD - Netstream/site.http.status[{#URL}])&gt;0</expression>
                                    <name>Site lento - {#HOST} acima de {$HTTP_WARN_MS}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Tempo de resposta HTTP de {#URL} acima de {$HTTP_WARN_MS}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>dacba2897aa74b598af69c5d44bab33b</uuid>
                            <name>HTTP - Status {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.status[{#URL}]</key>
                            <delay>2m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Codigo de status HTTP de {#URL}. 0=inacessivel, 200=OK.</description>
                            <valuemap>
                                <name>HTTP Status Code</name>
                            </valuemap>
                            <tags>
                                <tag><tag>component</tag><value>http</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>06cbfd104ff14f129f36d523a0f03714</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.http.status[{#URL}])=0</expression>
                                    <name>Site INACESSIVEL - {#HOST}</name>
                                    <priority>DISASTER</priority>
                                    <description>Sem resposta HTTP de {#URL}. Site fora do ar ou sem conectividade.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>f674ac1f58b54c05b623b6b14e84715a</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.http.status[{#URL}])&gt;=400 and last(/Template Internet Quality Linux LLD - Netstream/site.http.status[{#URL}])&lt;&gt;0</expression>
                                    <name>Erro HTTP - {#HOST} status &gt;= 400</name>
                                    <priority>HIGH</priority>
                                    <description>{#URL} retornando erro HTTP (4xx/5xx).</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>http</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>b377e622118c4907b7ad4a01f7a3a674</uuid>
                            <name>SSL - Dias para Expiracao {#HOST}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>site.http.ssl_days[{#URL}]</key>
                            <delay>1h</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>days</units>
                            <description>Dias restantes ate expiracao do certificado SSL de {#URL} via openssl/curl.</description>
                            <tags>
                                <tag><tag>component</tag><value>ssl</value></tag>
                                <tag><tag>site</tag><value>{#HOST}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>3f6d071050f047e0af9285ce564e95d3</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.http.ssl_days[{#URL}])&lt;{$SSL_HIGH_DAYS} and last(/Template Internet Quality Linux LLD - Netstream/site.http.ssl_days[{#URL}])&gt;=0</expression>
                                    <name>SSL expirando em menos de {$SSL_HIGH_DAYS} dias - {#HOST}</name>
                                    <priority>HIGH</priority>
                                    <description>Certificado SSL de {#URL} expira em menos de {$SSL_HIGH_DAYS} dias. Renovar URGENTE.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ssl</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>48df3c368d3847c99bf70fff9983730c</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/site.http.ssl_days[{#URL}])&lt;{$SSL_WARN_DAYS} and last(/Template Internet Quality Linux LLD - Netstream/site.http.ssl_days[{#URL}])&gt;={$SSL_HIGH_DAYS}</expression>
                                    <name>SSL expirando em menos de {$SSL_WARN_DAYS} dias - {#HOST}</name>
                                    <priority>WARNING</priority>
                                    <description>Certificado SSL de {#URL} expira em menos de {$SSL_WARN_DAYS} dias.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ssl</value></tag>
                                        <tag><tag>site</tag><value>{#HOST}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>c24281994c6b422dbc85c828509ea73a</uuid>
                            <name>HTTP - Tempo de Resposta: {#HOST}</name>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>6C59DC</color>
