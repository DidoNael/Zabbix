                    <type>ZABBIX_ACTIVE</type>
                    <key>internet.speed.upload</key>
                    <delay>15m</delay>
                    <value_type>FLOAT</value_type>
                    <units>Mbps</units>
                    <description>Velocidade de upload via Speedtest CLI (Ookla). Script: speedtest_check.sh</description>
