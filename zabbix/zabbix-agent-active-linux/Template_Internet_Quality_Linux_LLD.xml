                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.latency[{#TARGET}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <description>Latencia media ICMP para {#TARGET}. Script: ping_check.sh</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>b6b6a3f34d67404aa27a01b42cf093d3</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.ping.latency[{#TARGET}])&gt;{$LATENCY_HIGH}</expression>
                                    <name>Latencia CRITICA - {#TARGET} acima de {$LATENCY_HIGH}ms</name>
                                    <priority>HIGH</priority>
                                    <description>Latencia ICMP para {#TARGET} acima de {$LATENCY_HIGH}ms.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>98d511167cf7418ea543273bdf2b2b86</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.ping.latency[{#TARGET}])&gt;{$LATENCY_WARN} and last(/Template Internet Quality Linux LLD - Netstream/internet.ping.latency[{#TARGET}])&lt;={$LATENCY_HIGH}</expression>
                                    <name>Alta latencia - {#TARGET} acima de {$LATENCY_WARN}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Latencia ICMP para {#TARGET} acima de {$LATENCY_WARN}ms.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>db64a36ddc584adc82241156bb48ae8b</uuid>
                            <name>Ping - Perda de Pacotes {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.loss[{#TARGET}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <description>Percentual de perda de pacotes ICMP para {#TARGET}.</description>
                            <tags>
                                <tag><tag>component</tag><value>ping</value></tag>
                                <tag><tag>target</tag><value>{#TARGET}</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>f93d5460c929454aae8c9d8bfd338dde</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.ping.loss[{#TARGET}])&gt;=100</expression>
                                    <name>Internet INACESSIVEL - {#TARGET} 100% perda</name>
                                    <priority>DISASTER</priority>
                                    <description>Perda de pacotes 100% para {#TARGET}. Destino completamente indisponivel.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>4cf7660b920e4e76aa929d67df35b856</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.ping.loss[{#TARGET}])&gt;{$LOSS_HIGH} and last(/Template Internet Quality Linux LLD - Netstream/internet.ping.loss[{#TARGET}])&lt;100</expression>
                                    <name>Alta perda de pacotes - {#TARGET} acima de {$LOSS_HIGH}%</name>
                                    <priority>HIGH</priority>
                                    <description>Perda de pacotes acima de {$LOSS_HIGH}% para {#TARGET}.</description>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>48b033f1616044899115b9c76abc7de4</uuid>
                                    <expression>last(/Template Internet Quality Linux LLD - Netstream/internet.ping.loss[{#TARGET}])&gt;{$LOSS_WARN} and last(/Template Internet Quality Linux LLD - Netstream/internet.ping.loss[{#TARGET}])&lt;={$LOSS_HIGH}</expression>
                                    <name>Perda de pacotes - {#TARGET} acima de {$LOSS_WARN}%</name>
                                    <priority>WARNING</priority>
                                    <description>Perda de pacotes acima de {$LOSS_WARN}% para {#TARGET}.</description>
                                    <tags>
                                        <tag><tag>component</tag><value>ping</value></tag>
                                        <tag><tag>target</tag><value>{#TARGET}</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>cca60b3a01d843a9846c2aefbc2fb97a</uuid>
                            <name>Ping - Jitter {#TARGET}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>internet.ping.jitter[{#TARGET}]</key>
