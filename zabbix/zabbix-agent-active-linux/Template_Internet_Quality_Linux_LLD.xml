            <discovery_rules>

                <!-- REGRA 1: PING -->
                <discovery_rule>
                    <uuid>70e0a741c2b14974bc7082f51338f45e</uuid>
                    <name>Descoberta de Targets de Ping</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>discover.ping["{$PING_TARGETS}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre targets de ping a partir da macro {$PING_TARGETS} (separados por virgula). Script: discover_ping.sh</description>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>9e20e7b104ed447698215b0b601cd370</uuid>
