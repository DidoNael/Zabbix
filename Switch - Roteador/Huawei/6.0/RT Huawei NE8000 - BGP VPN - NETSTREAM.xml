<?xml version="1.0" encoding="utf-8"?>
<zabbix_export>
    <version>6.0</version>
    <groups>
        <group>
            <uuid>2d93b0766b5e4aef8d399801b8f11793</uuid>
            <name>NETSTREAM</name>
        </group>
        <group>
            <uuid>a1b2c3d4e5f64a7b8c9d0e1f2a3b4c5d</uuid>
            <name>NETSTREAM/HUAWEI</name>
        </group>
    </groups>
    <templates>
        <template>
            <uuid>f1e2d3c4b5a647382918a7b6c5d4e3f2</uuid>
            <template>RT Huawei NE8000 - BGP VPN - NETSTREAM</template>
            <name>RT Huawei NE8000 - BGP VPN - NETSTREAM</name>
            <description>Netstream Telecomunicações — netstream.net.br
Contato: (11) 95990-4100 | suporte@netstream.net.br

Monitoramento BGP de VPN Instances no Huawei NE8000 via SNMP.
MIB: hwBgpMIB (1.3.6.1.4.1.2011.5.25.177)

Descobre e monitora peers BGP nas VPN instances (IX-FOR-CE, IX-RJO-RJ, IX-SPO-SP4, etc.)
excluindo os peers do contexto global (Public/PublicV6).

Estado BGP mapeado: 1=Idle, 2=Connect, 3=Active, 4=OpenSent, 5=OpenConfirm, 6=Established

AVISO DE PROPRIEDADE INTELECTUAL
Este template é propriedade exclusiva da Netstream Telecomunicações.
É proibida a cópia, distribuição, modificação ou qualquer uso sem
autorização prévia e por escrito da Netstream Telecomunicações.
Todos os direitos reservados.</description>
            <groups>
                <group>
                    <name>NETSTREAM</name>
                </group>
                <group>
                    <name>NETSTREAM/HUAWEI</name>
                </group>
            </groups>
            <discovery_rules>
                <discovery_rule>
                    <uuid>a2b3c4d5e6f74a8b9c0d1e2f3a4b5c6d</uuid>
                    <name>Descoberta BGP VPN Peers</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#HW_BGP_VRF},1.3.6.1.4.1.2011.5.25.177.1.1.1.1.6]</snmp_oid>
                    <key>netstream.bgp.vpn.discovery</key>
                    <delay>5m</delay>
                    <lifetime>30d</lifetime>
                    <filter>
                        <eval_type>AND</eval_type>
                        <conditions>
                            <condition>
                                <macro>{#HW_BGP_VRF}</macro>
                                <value>^Public</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <description>Descobre peers BGP nas VPN instances via hwBgpMIB.
OID .177.1.1.1.1.6 retorna o nome do VRF de cada peer.
Indice SNMP: {VRF_IDX}.{AFI}.{SAFI}.{ADDR_TYPE}.{IP_OCTETS}
Filtro exclui contexto global (Public/PublicV6).</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>b3c4d5e6f7a84b9c0d1e2f3a4b5c6d7e</uuid>
                            <name>BGP VPN - {#HW_BGP_VRF}: peer {#SNMPINDEX} - Estado</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2011.5.25.177.1.1.2.1.5.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.bgp.vpn.peer.state[{#SNMPINDEX}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <description>Estado da sessão BGP do peer na VPN instance {#HW_BGP_VRF}.
1=Idle, 2=Connect, 3=Active, 4=OpenSent, 5=OpenConfirm, 6=Established</description>
                            <valuemap>
                                <name>Huawei BGP Peer State</name>
                            </valuemap>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>BGP VPN</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>c4d5e6f7a8b94c0d1e2f3a4b5c6d7e8f</uuid>
                                    <expression>last(/RT Huawei NE8000 - BGP VPN - NETSTREAM/netstream.bgp.vpn.peer.state[{#SNMPINDEX}])&lt;&gt;6</expression>
                                    <recovery_expression>last(/RT Huawei NE8000 - BGP VPN - NETSTREAM/netstream.bgp.vpn.peer.state[{#SNMPINDEX}])=6</recovery_expression>
                                    <name>BGP VPN - {#HW_BGP_VRF}: peer {#SNMPINDEX} não estabelecido (state={ITEM.LASTVALUE1})</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <description>Sessão BGP na VPN instance {#HW_BGP_VRF} não está Established.
Verificar conectividade, config BGP e logs do NE8000.</description>
                                    <tags>
                                        <tag>
                                            <tag>notificar</tag>
                                            <value>telegram</value>
                                        </tag>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>BGP</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Peer_Down</value>
                                        </tag>
                                        <tag>
                                            <tag>vrf</tag>
                                            <value>{#HW_BGP_VRF}</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d5e6f7a8b9c04d1e2f3a4b5c6d7e8f9a</uuid>
                            <name>BGP VPN - {#HW_BGP_VRF}: peer {#SNMPINDEX} - Prefixos Recebidos</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2011.5.25.177.1.1.2.1.2.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.bgp.vpn.peer.prefixes[{#SNMPINDEX}]</key>
                            <delay>2m</delay>
                            <history>30d</history>
                            <trends>365d</trends>
                            <description>Número de prefixos BGP recebidos do peer na VPN instance {#HW_BGP_VRF}.</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>BGP VPN</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>e6f7a8b9c0d14e2f3a4b5c6d7e8f9a0b</uuid>
                            <name>BGP VPN - {#HW_BGP_VRF}: peer {#SNMPINDEX} - IP Remoto</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2011.5.25.177.1.1.2.1.4.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.bgp.vpn.peer.remoteip[{#SNMPINDEX}]</key>
                            <delay>15m</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Endereço IP do peer BGP remoto na VPN instance {#HW_BGP_VRF}.</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>BGP VPN</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
            <valuemaps>
                <valuemap>
                    <uuid>f7a8b9c0d1e24f3a4b5c6d7e8f9a0b1c</uuid>
                    <name>Huawei BGP Peer State</name>
                    <mappings>
                        <mapping>
                            <value>1</value>
                            <newvalue>Idle</newvalue>
                        </mapping>
                        <mapping>
                            <value>2</value>
                            <newvalue>Connect</newvalue>
                        </mapping>
                        <mapping>
                            <value>3</value>
                            <newvalue>Active</newvalue>
                        </mapping>
                        <mapping>
                            <value>4</value>
                            <newvalue>OpenSent</newvalue>
                        </mapping>
                        <mapping>
                            <value>5</value>
                            <newvalue>OpenConfirm</newvalue>
                        </mapping>
                        <mapping>
                            <value>6</value>
                            <newvalue>Established</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
</zabbix_export>
