                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>last(/Template Switch Cisco - Netstream/netstream.if.status[{#SNMPINDEX}])=1</recovery_expression>
                                    <name>Interface {#IFNAME}: Link DOWN em {HOST.NAME}</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
