            <items>
                <item>
                    <uuid>4187d6780bc440378e384ce55149a487</uuid>
                    <name>Uptime do Sistema</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>1.3.6.1.2.1.1.3.0</snmp_oid>
                    <key>netstream.sysUpTime.0</key>
                    <delay>5m</delay>
                    <history>1d</history>
                    <trends>15d</trends>
                    <units>uptime</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <params>0.01</params>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>eb5b7931ee0745fc8f7976314752b82c</uuid>
                            <expression>last(/Template Switch Cisco - Netstream/netstream.sysUpTime.0)&lt;600 or change(/Template Switch Cisco - Netstream/netstream.sysUpTime.0)&lt;0</expression>
                            <name>Switch Cisco: Equipamento Reiniciou (Uptime &lt; 10m)</name>
                            <priority>WARNING</priority>
                            <description>O switch reiniciou recentemente ou perdeu energia.</description>
                            <tags>
                                <tag>
                                    <tag>Scope</tag>
                                    <value>Availability</value>
                                </tag>
                                <tag>
                                    <tag>Event</tag>
                                    <value>Reboot</value>
                                </tag>
                            </tags>
                        </trigger>
                        <trigger>
                            <uuid>61cfc01d7bc541ddb9008f3553a091fd</uuid>
                            <expression>nodata(/Template Switch Cisco - Netstream/netstream.sysUpTime.0,15m)=1</expression>
                            <name>Switch Cisco: Equipamento Inacessivel (Sem resposta SNMP ha 15m)</name>
                            <status>DISABLED</status>
                            <priority>DISASTER</priority>
                            <tags>
                                <tag>
                                    <tag>Scope</tag>
                                    <value>Availability</value>
                                </tag>
                                <tag>
                                    <tag>Event</tag>
                                    <value>Offline</value>
                                </tag>
                            </tags>
                        </trigger>
                    </triggers>
                </item>
