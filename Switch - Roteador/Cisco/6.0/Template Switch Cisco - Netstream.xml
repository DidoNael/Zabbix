                <discovery_rule>
                    <uuid>127638cc7b2148ce97bc392aa2182aaf</uuid>
                    <name>Discovery: Memoria (CISCO-MEMORY-POOL-MIB)</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#MEMNAME},1.3.6.1.4.1.9.9.48.1.1.1.2]</snmp_oid>
                    <key>netstream.cisco.mem.discovery</key>
                    <delay>1d</delay>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>8d72cc530de74b638c9611a549811f65</uuid>
                            <name>Memoria {#MEMNAME}: Usada (bytes)</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.9.9.48.1.1.1.5.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.cisco.mem.used[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <units>B</units>
                        </item_prototype>
                        <item_prototype>
                            <uuid>551d11ff706d4546ae3a342e19dc0855</uuid>
                            <name>Memoria {#MEMNAME}: Livre (bytes)</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.9.9.48.1.1.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.cisco.mem.free[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <units>B</units>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>988e86f3fcfa4f09ba371571a1b0abb0</uuid>
                                    <expression>last(/Template Switch Cisco - Netstream/netstream.cisco.mem.free[{#SNMPINDEX}])/(last(/Template Switch Cisco - Netstream/netstream.cisco.mem.free[{#SNMPINDEX}])+last(/Template Switch Cisco - Netstream/netstream.cisco.mem.used[{#SNMPINDEX}]))*100&lt;(100-{$MEM_WARN})</expression>
                                    <name>Memoria {#MEMNAME}: Uso acima de {$MEM_WARN}% em {HOST.NAME}</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>Scope</tag>
                                            <value>Memory</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
                <discovery_rule>
                    <uuid>1e8ff7c6176942b6936e2c306a56a87c</uuid>
                    <name>Discovery: Interfaces de Rede</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#SNMPVALUE},1.3.6.1.2.1.2.2.1.8,{#IFADMINSTATUS},1.3.6.1.2.1.2.2.1.7,{#IFNAME},1.3.6.1.2.1.2.2.1.2,{#IFTYPE},1.3.6.1.2.1.2.2.1.3]</snmp_oid>
                    <key>netstream.if.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#IFTYPE}</macro>
                                <value>^6$</value>
                                <formulaid>A</formulaid>
                            </condition>
                            <condition>
                                <macro>{#IFADMINSTATUS}</macro>
                                <value>^1$</value>
                                <formulaid>B</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime>2h</lifetime>
                    <item_prototypes>
                        <item_prototype>
