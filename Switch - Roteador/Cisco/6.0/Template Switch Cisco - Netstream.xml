            <discovery_rules>
                <discovery_rule>
                    <uuid>f001c2a609d34a6a86f9b962ae811687</uuid>
                    <name>Discovery: CPU (CISCO-PROCESS-MIB)</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#CPU},1.3.6.1.4.1.9.9.109.1.1.1.1.2]</snmp_oid>
                    <key>netstream.cisco.cpu.discovery</key>
                    <delay>1d</delay>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>11a2cc8229aa47cd97c9f17d2a4cc1db</uuid>
                            <name>CPU {#SNMPINDEX}: Uso em 1min</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.9.9.109.1.1.1.1.4.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.cisco.cpu.1min[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <units>%</units>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>2e6e2ad92f4a479e94b32c7292c33d8f</uuid>
                                    <expression>min(/Template Switch Cisco - Netstream/netstream.cisco.cpu.1min[{#SNMPINDEX}],5m)&gt;{$CPU_WARN}</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>min(/Template Switch Cisco - Netstream/netstream.cisco.cpu.1min[{#SNMPINDEX}],5m)&lt;{$CPU_WARN}</recovery_expression>
                                    <name>CPU acima de {$CPU_WARN}% por 5min em {HOST.NAME}</name>
                                    <priority>HIGH</priority>
                                    <tags>
                                        <tag>
                                            <tag>Scope</tag>
                                            <value>CPU</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>0a490ef92df644a5bf6648ee5a78bb81</uuid>
