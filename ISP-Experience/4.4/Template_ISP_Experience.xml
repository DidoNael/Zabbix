<?xml version="1.0" encoding="utf-8"?>
<zabbix_export>
    <version>4.4</version>
    <date>2026-07-13T18:44:02Z</date>
    <groups>
        <group>
            <name>Templates/Network/ISP Experience</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Netstream - Templates/Network/ISP Experience</template>
            <name>Netstream - Templates/Network/ISP Experience</name>
            <description>Template v2.0 com MTR Trace integrado e protecao anti-falso positivo contra bloqueio de ICMP Ping em Bancos/CDNs.</description>
            <groups>
                <group>
                    <name>Templates/Network/ISP Experience</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>ISP Experience - Geral</name>
                </application>
                <application>
                    <name>ISP Experience - Rota e MTR</name>
                </application>
                <application>
                    <name>ISP Experience - Latencia e Perda</name>
                </application>
            </applications>
            <discovery_rules>
                <discovery_rule>
                    <name>Descoberta de Servicos Web e Jogos (IX vs Transito)</name>
                    <type>EXTERNAL</type>
                    <key>discovery_isp_services.sh["{}"]</key>
                    <delay>1h</delay>
                    <item_prototypes>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Coleta Bruta Experiencia e Rota</name>
                            <type>EXTERNAL</type>
                            <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            <delay>1m</delay>
                            <history>1d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Geral</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Status Online (0=Offline, 1=Online)</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.status["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Geral</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.status</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Rota Atual (IX ou Transito)</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.current_route["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Rota e MTR</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.current_route</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Status da Rota / Desvio</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.route_status["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Rota e MTR</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_status</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Indicador de Desvio de Rota</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.route_changed["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Rota e MTR</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_changed</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Resumo do Salto e IP</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.route_summary["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Rota e MTR</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_summary</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: MTR Trace Completo</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.mtr_trace["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <applications>
                                <application>
                                    <name>ISP Experience - Rota e MTR</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.mtr_trace</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Latencia TCP Handshake</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.tcp_handshake["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <applications>
                                <application>
                                    <name>ISP Experience - Latencia e Perda</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.tcp_handshake_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Tempo de Resposta HTTP</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.http_time["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <applications>
                                <application>
                                    <name>ISP Experience - Latencia e Perda</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.http_time_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Latencia ICMP Ping</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.icmp_ping["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <applications>
                                <application>
                                    <name>ISP Experience - Latencia e Perda</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.icmp_ping_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <name>[{#CATEGORY}] {#NAME}: Perda Efetiva ICMP (Normalizada)</name>
                            <type>DEPENDENT</type>
                            <key>isp.service.icmp_loss["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <applications>
                                <application>
                                    <name>ISP Experience - Latencia e Perda</name>
                                </application>
                            </applications>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.icmp_loss_pct</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <expression>{Netstream - Templates/Network/ISP Experience:isp.service.route_changed["{#ID}"].min(15m)}=1</expression>
                            <name>[{#CATEGORY}] {#NAME}: Trafego desviado da rota esperada ({#EXPECTED_ROUTE}) ha 15m</name>
                            <priority>WARNING</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Netstream - Templates/Network/ISP Experience:isp.service.status["{#ID}"].max(3m)}=0</expression>
                            <name>[{#CATEGORY}] {#NAME}: Servico totalmente Inacessivel (HTTP, TCP e Ping indisponiveis ha 3m)</name>
                            <priority>DISASTER</priority>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>
            <macros>
                <macro>
                    <macro>{$ISP_CONFIG_PATH}</macro>
                    <value>/etc/zabbix/isp_services.json</value>
                </macro>
            </macros>
        </template>
    </templates>
</zabbix_export>