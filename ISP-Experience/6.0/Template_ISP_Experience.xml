        </group>
    </groups>
    <templates>
        <template>
            <uuid>a11a11b22b33c44d55e66f77a88b99c0</uuid>
            <template>Template ISP Experience - Netstream</template>
            <name>Template ISP Experience - Netstream</name>
            <description>Template v2.0 com MTR Trace integrado e protecao anti-falso positivo contra bloqueio de ICMP Ping em Bancos/CDNs.</description>
            <groups>
                <group>
                    <name>Templates/Network/ISP Experience</name>
                </group>
                <group>
                    <name>NETSTREAM</name>
                </group>
            </groups>
            <discovery_rules>
                <discovery_rule>
                    <uuid>b22b22c33c44d55e66f77a88b99c111</uuid>
                    <name>Descoberta de Servicos Web e Jogos (IX vs Transito)</name>
                    <type>EXTERNAL</type>
                    <key>discovery_isp_services.sh["{}"]</key>
                    <delay>1h</delay>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>c33c33d44d55e66f77a88b99c222</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Coleta Bruta Experiencia e Rota</name>
                            <type>EXTERNAL</type>
                            <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            <delay>1m</delay>
                            <history>1d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c332</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Status Online (0=Offline, 1=Online)</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.status["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.status</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c333</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Rota Atual (IX ou Transito)</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.current_route["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.current_route</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c334</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Status da Rota / Desvio</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.route_status["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_status</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c335</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Indicador de Desvio de Rota</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.route_changed["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_changed</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c336</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Resumo do Salto e IP</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.route_summary["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.route_summary</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c341</uuid>
                            <name>[{#CATEGORY}] {#NAME}: MTR Trace Completo</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.mtr_trace["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.mtr_trace</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c337</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Latencia TCP Handshake</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.tcp_handshake["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.tcp_handshake_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c338</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Tempo de Resposta HTTP</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.http_time["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.http_time_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c339</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Latencia ICMP Ping</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.icmp_ping["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.icmp_ping_ms</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d44d44e55e66f77a88b99c340</uuid>
                            <name>[{#CATEGORY}] {#NAME}: Perda Efetiva ICMP (Normalizada)</name>
                            <type>DEPENDENT</type>
                            <key>netstream.isp.icmp_loss["{#ID}"]</key>
                            <delay>0</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <params>$.icmp_loss_pct</params>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>monitor_isp_experience.sh["{#ID}","{#TARGET}","{#PORT}","{#EXPECTED_ROUTE}"]</key>
                            </master_item>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>e55e55f66f77a88b99c00d441</uuid>
                            <expression>min(/Template ISP Experience - Netstream/netstream.isp.route_changed["{#ID}"],15m)=1</expression>
                            <name>[{#CATEGORY}] {#NAME}: Trafego desviado da rota esperada ({#EXPECTED_ROUTE}) ha 15m</name>
                            <priority>WARNING</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>e55e55f66f77a88b99c00d442</uuid>
                            <expression>max(/Template ISP Experience - Netstream/netstream.isp.status["{#ID}"],3m)=0</expression>
                            <name>[{#CATEGORY}] {#NAME}: Servico totalmente Inacessivel (HTTP, TCP e Ping indisponiveis ha 3m)</name>
                            <priority>DISASTER</priority>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>
            <macros>
                <macro>
                    <macro>{$ISP_CONFIG_PATH}</macro>
                    <value>/etc/zabbix/isp_services.json</value>
                </macro>
            </macros>
        </template>
    </templates>
</zabbix_export>