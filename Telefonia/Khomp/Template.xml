<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>4.4</version>
    <date>2026-08-11T12:21:54Z</date>
    <groups>
        <group>
            <name>E1</name>
        </group>
        <group>
            <name>NETSTREAM</name>
        </group>
        <group>
            <name>Telefonia</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Khomp Gateway E1 - Netstream</template>
            <name>Khomp Gateway E1 - Netstream</name>
            <description>Template para monitoramento de Gateways E1 Khomp via SNMP.
OID correto para canais em falha: k3lDeviceLinkChannelCountFail
  = 1.3.6.1.4.1.32624.2.1.2.3.1.27.{$KHOMP_SERIAL}.{#SNMPINDEX}

Macros obrigatorias:
  {$SNMP_COMMUNITY}  — padrao: khomp
  {$KHOMP_SERIAL}    — numero serial do dispositivo (ex: 169900)</description>
            <groups>
                <group>
                    <name>E1</name>
                </group>
                <group>
                    <name>NETSTREAM</name>
                </group>
                <group>
                    <name>Telefonia</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>E1 Links</name>
                </application>
                <application>
                    <name>NAP Canais</name>
                </application>
            </applications>
            <discovery_rules>
                <!-- ============================================================ -->
                <!-- DISCOVERY LINK E1 — status + canais Falha/Livre/Ocupado      -->
                <!-- OIDs da tabela k3lDeviceLinkEntry (32624.2.1.2.3.1)          -->
                <!-- ============================================================ -->
                <discovery_rule>
                    <name>Discovery Link E1</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>discovery[{#E1DESCLINK}, 1.3.6.1.4.1.32624.2.1.2.3.1.3.{$KHOMP_SERIAL}]</snmp_oid>
                    <key>E1.discovery</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <!-- Status do link (up=1 / down=0) -->
                        <item_prototype>
                            <name>LINK E1 [{#E1DESCLINK}] - Status</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.2.1.2.3.1.2.{$KHOMP_SERIAL}.{#SNMPINDEX}</snmp_oid>
                            <key>link.status[{#E1DESCLINK}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>E1 Links</name>
                                </application>
                            </applications>
                            <valuemap>
                                <name>UP / DOWN</name>
                            </valuemap>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{last()}=0</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{last()}=1</recovery_expression>
                                    <name>LINK E1 [{#E1DESCLINK}] - Link inativo (DOWN)</name>
                                    <priority>DISASTER</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>E1</tag>
                                            <value>{#E1DESCLINK}</value>
                                        </tag>
                                        <tag>
                                            <tag>Tipo</tag>
                                            <value>Link_Down</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <!-- Canais em Falha — k3lDeviceLinkChannelCountFail (.27) -->
                        <item_prototype>
                            <name>LINK E1 [{#E1DESCLINK}] - Canais em Falha</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.2.1.2.3.1.27.{$KHOMP_SERIAL}.{#SNMPINDEX}</snmp_oid>
                            <key>link.fail[{#E1DESCLINK}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>canais</units>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>E1 Links</name>
                                </application>
                            </applications>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{last()}&gt;0</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{last()}=0</recovery_expression>
                                    <name>LINK E1 [{#E1DESCLINK}] - Falha total de canais ({ITEM.VALUE} canais)</name>
                                    <priority>DISASTER</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>E1</tag>
                                            <value>{#E1DESCLINK}</value>
                                        </tag>
                                        <tag>
                                            <tag>Tipo</tag>
                                            <value>Falha_Canal</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <!-- Canais Livres (Idle) — k3lDeviceLinkChannelCountIdle (.26) -->
                        <item_prototype>
                            <name>LINK E1 [{#E1DESCLINK}] - Canais Livres</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.2.1.2.3.1.26.{$KHOMP_SERIAL}.{#SNMPINDEX}</snmp_oid>
                            <key>link.idle[{#E1DESCLINK}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>canais</units>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>E1 Links</name>
                                </application>
                            </applications>
                        </item_prototype>

                        <!-- Canais Ocupados (Busy) — k3lDeviceLinkChannelCountBusy (.28) -->
                        <item_prototype>
                            <name>LINK E1 [{#E1DESCLINK}] - Canais Ocupados</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.2.1.2.3.1.28.{$KHOMP_SERIAL}.{#SNMPINDEX}</snmp_oid>
                            <key>link.busy[{#E1DESCLINK}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>canais</units>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>E1 Links</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>

                <!-- ============================================================ -->
                <!-- DISCOVERY NAP — nome e contagem de canais (tabela app)       -->
                <!-- Livre e Ocupado corretos; Falha nao disponivel nesta tabela  -->
                <!-- ============================================================ -->
                <discovery_rule>
                    <name>Discovery NAP</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>discovery[{#E1DESCNAP}, app.1.1.1.2.1.2]</snmp_oid>
                    <key>E1.discoverynap</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <name>NAP [{#E1DESCNAP}] - Canais Livres</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.3.1.1.1.2.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>nap.livre[{#E1DESCNAP}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>canais</units>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>NAP Canais</name>
                                </application>
                            </applications>
                        </item_prototype>

                        <item_prototype>
                            <name>NAP [{#E1DESCNAP}] - Canais Ocupados</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.32624.3.1.1.1.2.1.7.{#SNMPINDEX}</snmp_oid>
                            <key>nap.ocupado[{#E1DESCNAP}]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>canais</units>
                            <port>161</port>
                            <applications>
                                <application>
                                    <name>NAP Canais</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
            <macros>
                <macro>
                    <macro>{$SNMP_COMMUNITY}</macro>
                    <value>khomp</value>
                </macro>
                <macro>
                    <macro>{$KHOMP_SERIAL}</macro>
                    <value>169900</value>
                    <description>Numero serial do dispositivo Khomp (ver snmpwalk k3lDeviceSerial)</description>
                </macro>
            </macros>
        </template>
    </templates>
    <value_maps>
        <value_map>
            <name>UP / DOWN</name>
            <mappings>
                <mapping>
                    <value>0</value>
                    <newvalue>down</newvalue>
                </mapping>
                <mapping>
                    <value>1</value>
                    <newvalue>up</newvalue>
                </mapping>
            </mappings>
        </value_map>
    </value_maps>
</zabbix_export>
