<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>4.4</version>
    <groups>
        <group>
            <name>Templates</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>OLT Datacom DmOS - NETSTREAM</template>
            <name>OLT Datacom DmOS - NETSTREAM</name>
            <description>Template para OLT Datacom DM4618 / DmOS&#13;
&#13;
Monitoramento:&#13;
- Uplinks (trafego, status, saturacao 90%)&#13;
- Portas GPON (status, trafego IN/OUT, saturacao 90% sustentada 10min)&#13;
- ONUs por PON (online, offline, total, alta ocupacao &gt;=90%)&#13;
- CPU e Memoria&#13;
- Uptime&#13;
&#13;
Enterprise OID base: 1.3.6.1.4.1.3709&#13;
ifType GPON = 250&#13;
ifType Uplink = 6 (ethernet-csmacd)</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <items>
                <item>
                    <name>Uptime</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>1.3.6.1.2.1.1.3.0</snmp_oid>
                    <key>sysUpTime</key>
                    <delay>5m</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <units>uptime</units>
                    <description>Tempo desde o ultimo reboot da OLT</description>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <params>0.01</params>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <name>CPU - Utilizacao</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>1.3.6.1.4.1.3709.3.6.4.1.2.1.2.1.1.49</snmp_oid>
                    <key>dmos.cpu.util</key>
                    <delay>3m</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <units>%</units>
                    <description>Percentual de CPU utilizado (slot 49 = linha principal)</description>
                    <triggers>
                        <trigger>
                            <expression>{max(10m)}&gt;85</expression>
                            <name>CPU alta (&gt;85%) em {HOST.NAME}</name>
                            <priority>HIGH</priority>
                            <manual_close>YES</manual_close>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>Memoria - Utilizacao</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>1.3.6.1.4.1.3709.3.6.4.1.2.1.4.1.1.49</snmp_oid>
                    <key>dmos.mem.util</key>
                    <delay>3m</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <units>%</units>
                    <description>Percentual de memoria utilizado (slot 49)</description>
                    <triggers>
                        <trigger>
                            <expression>{max(10m)}&gt;90</expression>
                            <name>Memoria alta (&gt;90%) em {HOST.NAME}</name>
                            <priority>HIGH</priority>
                            <manual_close>YES</manual_close>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <name>NETSTREAM - Descoberta de Uplinks</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>discovery[{#SNMPVALUE},1.3.6.1.2.1.2.2.1.8,{#IFADMINSTATUS},1.3.6.1.2.1.2.2.1.7,{#IFNAME},1.3.6.1.2.1.2.2.1.2,{#IFTYPE},1.3.6.1.2.1.2.2.1.3,{#IFSPEED},1.3.6.1.2.1.31.1.1.1.15]</snmp_oid>
                    <key>netstream.uplink.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#IFTYPE}</macro>
                                <value>^6$</value>
                                <formulaid>A</formulaid>
                            </condition>
                            <condition>
                                <macro>{#IFADMINSTATUS}</macro>
                                <value>^1$</value>
                                <formulaid>B</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime>2h</lifetime>
                    <description>Descobre interfaces uplink (ifType=6, ethernet) administrativamente ativas</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Trafego de Entrada (IN)</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.31.1.1.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.in.bps[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <params>8</params>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Trafego de Saida (OUT)</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.31.1.1.1.10.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.out.bps[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <params>8</params>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Status Operacional</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.2.2.1.8.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.status[{#SNMPINDEX}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{OLT Datacom DmOS - NETSTREAM:netstream.uplink.status[{#SNMPINDEX}].max(#3)}=2 and {OLT Datacom DmOS - NETSTREAM:netstream.uplink.status[{#SNMPINDEX}].diff()}=1 and {OLT Datacom DmOS - NETSTREAM:netstream.uplink.status[{#SNMPINDEX}].count(10m)}&gt;1</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{OLT Datacom DmOS - NETSTREAM:netstream.uplink.status[{#SNMPINDEX}].last()}=1</recovery_expression>
                                    <name>Uplink {#IFNAME}: Link DOWN</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Link_Down</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Velocidade</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.31.1.1.1.15.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.ifspeed[{#SNMPINDEX}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <params>1000000</params>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Erros de Entrada</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.2.2.1.14.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.in.errors[{#SNMPINDEX}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>Uplink {#IFNAME}: Erros de Saida</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.2.2.1.20.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.uplink.out.errors[{#SNMPINDEX}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <name>Uplink {#IFNAME}: Trafego</name>
                            <graph_items>
                                <graph_item>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.uplink.in.bps[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>2774A4</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.uplink.out.bps[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
                <discovery_rule>
                    <name>NETSTREAM - Descoberta de Portas GPON</name>
                    <type>SNMPV2</type>
                    <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                    <snmp_oid>discovery[{#SNMPVALUE},1.3.6.1.2.1.2.2.1.8,{#IFNAME},1.3.6.1.2.1.2.2.1.2,{#IFTYPE},1.3.6.1.2.1.2.2.1.3]</snmp_oid>
                    <key>netstream.gpon.port.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#IFTYPE}</macro>
                                <value>^250$</value>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime>2h</lifetime>
                    <description>Descobre portas GPON (ifType=250)</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>Porta {#IFNAME}: Status Operacional</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.2.2.1.8.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.port.status[{#SNMPINDEX}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.status[{#SNMPINDEX}].max(#3)}=2 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.status[{#SNMPINDEX}].diff()}=1 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.status[{#SNMPINDEX}].count(10m)}&gt;1</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.status[{#SNMPINDEX}].last()}=1</recovery_expression>
                                    <name>Porta GPON {#IFNAME}: Apagada (Inativa)</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>GPON_Down</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>Porta {#IFNAME}: ONUs Online</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.3709.3.6.18.2.1.5.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.onu.online[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <description>ONUs com sinal ativo na porta</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].last()}=0 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.total[{#SNMPINDEX}].last()}&gt;0 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].count(10m)}&gt;1</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].last()}&gt;0</recovery_expression>
                                    <name>Porta GPON {#IFNAME}: Queda total de ONUs</name>
                                    <priority>DISASTER</priority>
                                    <manual_close>NO</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Queda_Total</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].change()}&lt;-{$GPON_DROP_MIN} and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].last()}&gt;0 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].count(10m)}&gt;1</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].change()}&gt;=0</recovery_expression>
                                    <name>Porta GPON {#IFNAME}: Queda parcial de ONUs</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Queda_Parcial</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].last()}&gt;={$GPON_MAX_ONUS}*0.9 and {OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.total[{#SNMPINDEX}].last()}&gt;0</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>{OLT Datacom DmOS - NETSTREAM:netstream.gpon.onu.online[{#SNMPINDEX}].last()}&lt;{$GPON_MAX_ONUS}*0.85</recovery_expression>
                                    <name>Porta GPON {#IFNAME}: Alta ocupacao de ONUs (&gt;=90%)</name>
                                    <priority>WARNING</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Ocupacao_ONUs</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>Porta {#IFNAME}: ONUs Offline</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.3709.3.6.18.2.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.onu.offline[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <description>ONUs sem sinal na porta</description>
                        </item_prototype>
                        <item_prototype>
                            <name>Porta {#IFNAME}: Total de ONUs</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.4.1.3709.3.6.18.2.1.3.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.onu.total[{#SNMPINDEX}]</key>
                            <delay>15m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <description>Total de ONUs cadastradas na porta</description>
                        </item_prototype>
                        <item_prototype>
                            <name>Porta {#IFNAME}: Trafego de Entrada (Upload ONUs)</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.31.1.1.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.port.in.bps[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>bps</units>
                            <description>Trafego de entrada na PON (upload dos clientes). Cap: 1.244 Gbps (GPON upstream).</description>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <params>8</params>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>Porta {#IFNAME}: Trafego de Saida (Download ONUs)</name>
                            <type>SNMPV2</type>
                            <snmp_community>{$SNMP_COMMUNITY}</snmp_community>
                            <snmp_oid>1.3.6.1.2.1.31.1.1.1.10.{#SNMPINDEX}</snmp_oid>
                            <key>netstream.gpon.port.out.bps[{#SNMPINDEX}]</key>
                            <delay>3m</delay>
                            <history>30d</history>
                            <trends>90d</trends>
                            <units>bps</units>
                            <description>Trafego de saida na PON (download dos clientes). Cap: 2.488 Gbps (GPON downstream).</description>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <params>8</params>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>({OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.out.bps[{#SNMPINDEX}].min(10m)}&gt;{$GPON_BW_DOWN}*0.9) or ({OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.in.bps[{#SNMPINDEX}].min(10m)}&gt;{$GPON_BW_UP}*0.9)</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>({OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.out.bps[{#SNMPINDEX}].max(5m)}&lt;{$GPON_BW_DOWN}*0.8) and ({OLT Datacom DmOS - NETSTREAM:netstream.gpon.port.in.bps[{#SNMPINDEX}].max(5m)}&lt;{$GPON_BW_UP}*0.8)</recovery_expression>
                                    <name>Porta GPON {#IFNAME}: Saturacao de trafego (&gt;90% sustentado por 10min)</name>
                                    <priority>HIGH</priority>
                                    <manual_close>YES</manual_close>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>OLT</value>
                                        </tag>
                                        <tag>
                                            <tag>tipo</tag>
                                            <value>Saturacao_GPON</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <name>Porta {#IFNAME}: Trafego GPON</name>
                            <graph_items>
                                <graph_item>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.gpon.port.in.bps[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>2774A4</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.gpon.port.out.bps[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <name>Porta {#IFNAME}: ONUs</name>
                            <graph_items>
                                <graph_item>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.gpon.onu.online[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <drawtype>GRADIENT_LINE</drawtype>
                                    <color>CC0000</color>
                                    <item>
                                        <host>OLT Datacom DmOS - NETSTREAM</host>
                                        <key>netstream.gpon.onu.offline[{#SNMPINDEX}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
            <macros>
                <macro>
                    <macro>{$SNMP_COMMUNITY}</macro>
                    <value>public</value>
                </macro>
                <macro>
                    <macro>{$CPU_WARN}</macro>
                    <value>85</value>
                </macro>
                <macro>
                    <macro>{$MEM_WARN}</macro>
                    <value>90</value>
                </macro>
                <macro>
