<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>4.4</version>
    <date>2026-08-11T00:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Network devices</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template NQA Huawei P2P - Netstream</template>
            <name>Template NQA Huawei P2P - Netstream</name>
            <description>Monitoramento de latência e perda de pacotes P2P via NQA ICMP nativo dos equipamentos Huawei.&#13;
&#13;
Requer script externo nqa_huawei.sh em /usr/lib/zabbix/externalscripts/&#13;
&#13;
Configurar por host:&#13;
  {$NQA_INSTANCE} = nome da instância NQA (ex: OSPF_PE4GRU_PE3EQNXSP4)&#13;
  {$SNMP_COMMUNITY} = community SNMP&#13;
  {$NQA_OWNER} = owner da instância (default: admin)</description>
            <groups>
                <group>
                    <name>Templates/Network devices</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>NQA P2P</name>
                </application>
            </applications>
            <items>
                <!-- Master item: coleta JSON via script externo -->
                <item>
                    <name>NQA P2P: Dados brutos [{$NQA_INSTANCE}]</name>
                    <type>EXTERNAL</type>
                    <key>nqa_huawei.sh[{HOST.IP},{$SNMP_COMMUNITY},{$NQA_OWNER},{$NQA_INSTANCE}]</key>
                    <delay>60</delay>
                    <history>1d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <description>JSON com RTT mín/máx/méd e perda de pacotes da instância NQA configurada.</description>
                    <applications>
                        <application>
                            <name>NQA P2P</name>
                        </application>
                    </applications>
                </item>

                <!-- RTT Mínimo -->
                <item>
                    <name>NQA P2P: RTT Mínimo [{$NQA_INSTANCE}]</name>
                    <type>DEPENDENT</type>
                    <key>nqa.rtt.min[{$NQA_INSTANCE}]</key>
                    <delay>0</delay>
                    <history>90d</history>
                    <trends>365d</trends>
                    <value_type>FLOAT</value_type>
                    <units>ms</units>
                    <master_item>
                        <key>nqa_huawei.sh[{HOST.IP},{$SNMP_COMMUNITY},{$NQA_OWNER},{$NQA_INSTANCE}]</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <params>$.rtt_min</params>
                        </step>
                    </preprocessing>
                    <applications>
                        <application>
                            <name>NQA P2P</name>
                        </application>
                    </applications>
                </item>

                <!-- RTT Máximo -->
                <item>
                    <name>NQA P2P: RTT Máximo [{$NQA_INSTANCE}]</name>
                    <type>DEPENDENT</type>
                    <key>nqa.rtt.max[{$NQA_INSTANCE}]</key>
                    <delay>0</delay>
                    <history>90d</history>
                    <trends>365d</trends>
                    <value_type>FLOAT</value_type>
                    <units>ms</units>
                    <master_item>
                        <key>nqa_huawei.sh[{HOST.IP},{$SNMP_COMMUNITY},{$NQA_OWNER},{$NQA_INSTANCE}]</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <params>$.rtt_max</params>
                        </step>
                    </preprocessing>
                    <applications>
                        <application>
                            <name>NQA P2P</name>
                        </application>
                    </applications>
                </item>

                <!-- RTT Médio -->
                <item>
                    <name>NQA P2P: RTT Médio [{$NQA_INSTANCE}]</name>
                    <type>DEPENDENT</type>
                    <key>nqa.rtt.avg[{$NQA_INSTANCE}]</key>
                    <delay>0</delay>
                    <history>90d</history>
                    <trends>365d</trends>
                    <value_type>FLOAT</value_type>
                    <units>ms</units>
                    <master_item>
                        <key>nqa_huawei.sh[{HOST.IP},{$SNMP_COMMUNITY},{$NQA_OWNER},{$NQA_INSTANCE}]</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <params>$.rtt_avg</params>
                        </step>
                    </preprocessing>
                    <applications>
                        <application>
                            <name>NQA P2P</name>
                        </application>
                    </applications>
                </item>

                <!-- Perda de pacotes -->
                <item>
                    <name>NQA P2P: Perda de pacotes [{$NQA_INSTANCE}]</name>
                    <type>DEPENDENT</type>
                    <key>nqa.loss[{$NQA_INSTANCE}]</key>
                    <delay>0</delay>
                    <history>90d</history>
                    <trends>365d</trends>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <master_item>
                        <key>nqa_huawei.sh[{HOST.IP},{$SNMP_COMMUNITY},{$NQA_OWNER},{$NQA_INSTANCE}]</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <params>$.loss_pct</params>
                        </step>
                    </preprocessing>
                    <applications>
                        <application>
                            <name>NQA P2P</name>
                        </application>
                    </applications>
                </item>
            </items>
            <triggers>
                <!-- WARNING: RTT alto -->
                <trigger>
                    <expression>{Template NQA Huawei P2P - Netstream:nqa.rtt.avg[{$NQA_INSTANCE}].avg(5m)}&gt;{$NQA_RTT_WARN}</expression>
                    <name>NQA P2P [{$NQA_INSTANCE}]: RTT elevado ({ITEM.VALUE}ms &gt; {$NQA_RTT_WARN}ms)</name>
                    <priority>WARNING</priority>
                    <manual_close>YES</manual_close>
                </trigger>

                <!-- HIGH: RTT muito alto -->
                <trigger>
                    <expression>{Template NQA Huawei P2P - Netstream:nqa.rtt.avg[{$NQA_INSTANCE}].avg(3m)}&gt;{$NQA_RTT_HIGH}</expression>
                    <name>NQA P2P [{$NQA_INSTANCE}]: RTT crítico ({ITEM.VALUE}ms &gt; {$NQA_RTT_HIGH}ms)</name>
                    <priority>HIGH</priority>
                    <manual_close>YES</manual_close>
                </trigger>

                <!-- HIGH: Perda de pacotes -->
                <trigger>
                    <expression>{Template NQA Huawei P2P - Netstream:nqa.loss[{$NQA_INSTANCE}].last()}&gt;{$NQA_LOSS_WARN}</expression>
                    <name>NQA P2P [{$NQA_INSTANCE}]: Perda de pacotes ({ITEM.VALUE}% &gt; {$NQA_LOSS_WARN}%)</name>
                    <priority>HIGH</priority>
                    <manual_close>YES</manual_close>
                </trigger>

                <!-- DISASTER: Link down (100% perda) -->
                <trigger>
                    <expression>{Template NQA Huawei P2P - Netstream:nqa.loss[{$NQA_INSTANCE}].last()}=100</expression>
                    <name>NQA P2P [{$NQA_INSTANCE}]: Link inacessível (100% perda)</name>
                    <priority>DISASTER</priority>
                    <manual_close>YES</manual_close>
                </trigger>
            </triggers>
            <macros>
                <macro>
                    <macro>{$NQA_OWNER}</macro>
                    <value>admin</value>
                </macro>
                <macro>
                    <macro>{$NQA_INSTANCE}</macro>
                    <value></value>
                    <description>Nome da instância NQA (ex: OSPF_PE4GRU_PE3EQNXSP4)</description>
                </macro>
                <macro>
                    <macro>{$NQA_RTT_WARN}</macro>
                    <value>50</value>
                    <description>RTT médio (ms) para alerta WARNING</description>
                </macro>
                <macro>
                    <macro>{$NQA_RTT_HIGH}</macro>
                    <value>100</value>
                    <description>RTT médio (ms) para alerta HIGH</description>
                </macro>
                <macro>
                    <macro>{$NQA_LOSS_WARN}</macro>
                    <value>5</value>
                    <description>Perda de pacotes (%) para alerta HIGH</description>
                </macro>
            </macros>
        </template>
    </templates>
</zabbix_export>
