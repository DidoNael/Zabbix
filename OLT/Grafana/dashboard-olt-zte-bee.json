table","rawQuery":true,"rawSql":"SELECT sub.host, sub.interface, sub.bitsin, sub.bitsout, sub.status, sub.speed, sub.usoin, sub.usoout, sub.rxpower, sub.txpower, sub.distancia, sub.limiterx, CASE WHEN sub.rxpower IS NULL THEN NULL WHEN sub.is_xgei = 1 AND (sub.rxpower \u003c -9.00 OR sub.rxpower \u003e 0.00) THEN 'anormal' WHEN sub.is_xgei = 0 AND (sub.rxpower \u003c -11.00 OR sub.rxpower \u003e -1.00) THEN 'anormal' END AS staturx, sub.ultverificacao FROM ( SELECT ht.name AS host, SUBSTRING_INDEX(it.name, ': ', 1) AS interface, MAX(CASE WHEN it.name LIKE '%Trafego de Entrada%' THEN h.value END) AS bitsin, MAX(CASE WHEN it.name LIKE '%Trafego de Saida%' THEN h.value END) AS bitsout, MAX(CASE WHEN it.name LIKE '%Status Operacional%' THEN h.value END) AS status, MAX(CASE WHEN it.name LIKE '%Velocidade da Porta%' THEN h.value END) AS speed, MAX(CASE WHEN it.name LIKE '%Trafego de Entrada%' THEN h.value END) / NULLIF(MAX(CASE WHEN it.name LIKE '%Velocidade da Porta%' THEN h.value END), 0) * 100 AS usoin, MAX(CASE WHEN it.name LIKE '%Trafego de Saida%' THEN h.value END) / NULLIF(MAX(CASE WHEN it.name LIKE '%Velocidade da Porta%' THEN h.value END), 0) * 100 AS usoout, MAX(CASE WHEN it.name LIKE '%Sinal RX%' THEN h.value END) AS rxpower, MAX(CASE WHEN it.name LIKE '%Sinal TX%' THEN h.value END) AS txpower, NULL AS distancia, MAX(CASE WHEN it.name LIKE '%xgei%' THEN '0.00 a -9.00' WHEN it.name LIKE '% gei_%' THEN '-1.00 a -11.00' END) AS limiterx, MAX(CASE WHEN it.name LIKE '%xgei%' THEN 1 ELSE 0 END) AS is_xgei, MAX(DATE_FORMAT(CONVERT_TZ(FROM_UNIXTIME(h.clock), '+00:00', '+00:00'), '%d-%m-%Y %H:%i:%s')) AS ultverificacao FROM items it INNER JOIN hosts ht ON ht.hostid = it.hostid AND ht.name IN ('$host') AND ht.status = 0 LEFT JOIN ( SELECT itemid, MAX(clock) AS max_clock FROM history WHERE clock \u003e UNIX_TIMESTAMP() - 7200 GROUP BY itemid ) AS max_h ON it.itemid = max_h.itemid LEFT JOIN history h ON h.itemid = max_h.itemid AND h.clock = max_h.max_clock INNER JOIN items_applications ia2 ON ia2.itemid = it.itemid INNER JOIN applications ap ON ap.applicationid = ia2.applicationid AND ap.name = 'Uplink / LAN OLT' WHERE it.flags IN (0, 4) AND it.status = 0 AND ( it.name LIKE '%Trafego%' OR it.name LIKE '%Status Operacional%' OR it.name LIKE '%Velocidade da Porta%' OR it.name LIKE '%Erros%' OR it.name LIKE '%Drops%' OR it.name LIKE '%Sinal RX%' OR it.name LIKE '%Sinal TX%' ) GROUP BY interface, host ) sub ORDER BY sub.interface;","refId":"A","sql":{"columns":[{"parameters":[],"type":"function"}],"groupBy":[{"property":{"type":"string"},"type":"groupBy"}],"limit":50}}],"title":"AnÃ¡lise de Interfaces (Uplinks)","transformations":[{"id":"organize","options":{"excludeByName":{"host":true},"includeByName":{},"indexByName":{},"renameByName":{"Interface":"","bitsin":"Bits In","bitsout":"Bits Out","consumoin":"Consumo In","consumoout":"Consumo Out","descartesin":"Descartes In","descartesout":"Descartes Out","distancia":"Distancia (KM)","errosin":"Erros In","errosout":"Erros Out","host":"Host","interface":"Interface","limiterx":"Limites Rx (dBm)","rxpower":"Rx Power (dBm)","rxpoweravg":"Rx Power Avg (dBm)","speed":"Speed","staturx":"Status Sinal","status":"Status","txpower":"Tx Power (dBm)","txpoweravg":"Tx Power Avg (dBm)","ultverificacao":"Ult. VerificaÃ§Ã£o","ultverificao":"Ult.Verificacao","usoin":"Uso In (%)","usoout":"Uso Out (%)"}}}],"type":"table"},{"datasource":{"type":"alexanderzobnin-zabbix-datasource","uid":"000000002"},"fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"axisBorderShow":false,"axisCenteredZero":false,"axisColorMode":"text","axisLabel":"","axisPlacement":"auto","barAlignment":0,"barWidthFactor":0.6,"drawStyle":"line","fillOpacity":58,"gradientMode":"none","hideFrom":{"legend":false,"tooltip":false,"viz":false},"insertNulls":false,"lineInterpolation":"linear","lineWidth":1,"pointSize":5,"scaleDistribution":{"type":"linear"},"showPoints":"auto","showValues":false,"spanNulls":false,"stacking":{"gro