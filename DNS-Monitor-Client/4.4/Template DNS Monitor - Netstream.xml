<?xml version="1.0" encoding="utf-8"?>
<zabbix_export>
    <version>4.4</version>
    <date>2026-07-27T00:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Network/DNS Monitor</name>
        </group>
        <group>
            <name>NETSTREAM</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template DNS Monitor - Netstream</template>
            <name>Template DNS Monitor - Netstream</name>
            <description>Netstream Telecomunicações — netstream.net.br
Contato: (11) 95990-4100 | suporte@netstream.net.br

AVISO DE PROPRIEDADE INTELECTUAL
Este template é propriedade exclusiva da Netstream Telecomunicações.
É proibida a cópia, distribuição, modificação ou qualquer uso sem
autorização prévia e por escrito da Netstream Telecomunicações.
Todos os direitos reservados.</description>
            <groups>
                <group>
                    <name>Templates/Network/DNS Monitor</name>
                </group>
                <group>
                    <name>NETSTREAM</name>
                </group>
            </groups>
            <applications>
                <application><name>DNS Monitor - DIG</name></application>
                <application><name>DNS Monitor - Tempo</name></application>
                <application><name>DNS Monitor - Status</name></application>
                <application><name>DNS Monitor - RCODE</name></application>
                <application><name>DNS Monitor - Resultado</name></application>
                <application><name>DNS Monitor - Respostas</name></application>
            </applications>
            <macros>
                <macro>
                    <macro>{$DNS_SERVERS_NETSTREAM}</macro>
                    <value>8.8.8.8,8.8.4.4,1.1.1.1</value>
                </macro>
                <macro>
                    <macro>{$DNS_DOMAINS_NETSTREAM}</macro>
                    <value>google.com</value>
                </macro>
                <macro>
                    <macro>{$DNS_TYPES_NETSTREAM}</macro>
                    <value>A</value>
                </macro>
                <macro>
                    <macro>{$DNS_TIMEOUT_NETSTREAM}</macro>
                    <value>5</value>
                </macro>
                <macro>
                    <macro>{$DNS_WARN_TIME_NETSTREAM}</macro>
                    <value>200</value>
                </macro>
                <macro>
                    <macro>{$DNS_CRIT_TIME_NETSTREAM}</macro>
                    <value>500</value>
                </macro>
            </macros>
            <discovery_rules>
                <discovery_rule>
                    <name>Descoberta de Combinacoes DNS</name>
                    <type>EXTERNAL</type>
                    <key>netstream_dns_discover.py["{$DNS_SERVERS_NETSTREAM}","{$DNS_DOMAINS_NETSTREAM}","{$DNS_TYPES_NETSTREAM}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre combinacoes de servidor x dominio x tipo de registro a partir das macros do host.</description>
                    <item_prototypes>

                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo de Resposta</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>ms</units>
                            <description>Tempo de resposta da consulta DIG em milissegundos. Retorna 9999 em timeout.</description>
                            <applications>
                                <application><name>DNS Monitor - DIG</name></application>
                                <application><name>DNS Monitor - Tempo</name></application>
                            </applications>
                            <application_prototypes>
                                <application_prototype><name>DNS Monitor - {#DNS_DOMAIN}</name></application_prototype>
                                <application_prototype><name>DNS Monitor - {#DNS_SERVER}</name></application_prototype>
                            </application_prototypes>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"].last()}>{$DNS_CRIT_TIME_NETSTREAM}</expression>
                                    <name>DNS DIG lento CRITICAL: {#DNS_SERVER} para {#DNS_DOMAIN} ({#DNS_TYPE}) &gt; {$DNS_CRIT_TIME_NETSTREAM}ms</name>
                                    <priority>HIGH</priority>
                                    <description>Tempo de resposta DIG acima do limiar CRITICAL ({$DNS_CRIT_TIME_NETSTREAM} ms).</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>tempo</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"].last()}>{$DNS_WARN_TIME_NETSTREAM} and {Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"].last()}&lt;={$DNS_CRIT_TIME_NETSTREAM}</expression>
                                    <name>DNS DIG lento WARNING: {#DNS_SERVER} para {#DNS_DOMAIN} ({#DNS_TYPE}) &gt; {$DNS_WARN_TIME_NETSTREAM}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Tempo de resposta DIG acima do limiar WARNING ({$DNS_WARN_TIME_NETSTREAM} ms).</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>tempo</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Status</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","status","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Status da consulta DIG: 1=Sucesso, 0=Falha (sem resposta ou timeout).</description>
                            <applications>
                                <application><name>DNS Monitor - DIG</name></application>
                                <application><name>DNS Monitor - Status</name></application>
                            </applications>
                            <application_prototypes>
                                <application_prototype><name>DNS Monitor - {#DNS_DOMAIN}</name></application_prototype>
                                <application_prototype><name>DNS Monitor - {#DNS_SERVER}</name></application_prototype>
                            </application_prototypes>
                            <valuemap>
                                <name>DNS Query Status</name>
                            </valuemap>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","status","{$DNS_TIMEOUT_NETSTREAM}"].min(#3)}=0</expression>
                                    <name>DNS DIG falhou: {#DNS_SERVER} nao resolveu {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>AVERAGE</priority>
                                    <description>A consulta DIG nao retornou resposta valida.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>status</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - RCODE</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <description>Codigo de resposta DNS: NOERROR, NXDOMAIN, SERVFAIL, REFUSED, TIMEOUT.</description>
                            <applications>
                                <application><name>DNS Monitor - DIG</name></application>
                                <application><name>DNS Monitor - RCODE</name></application>
                            </applications>
                            <application_prototypes>
                                <application_prototype><name>DNS Monitor - {#DNS_DOMAIN}</name></application_prototype>
                                <application_prototype><name>DNS Monitor - {#DNS_SERVER}</name></application_prototype>
                            </application_prototypes>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"].str(NOERROR)}=0 and {Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"].count(10m)}&gt;1</expression>
                                    <name>DNS DIG RCODE anormal: {#DNS_SERVER} retornou {ITEM.LASTVALUE} para {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>WARNING</priority>
                                    <description>O servidor DNS retornou codigo de erro diferente de NOERROR.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>rcode</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Resultado</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","result","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Registros retornados pelo DIG (primeiros 5, separados por virgula).</description>
                            <applications>
                                <application><name>DNS Monitor - DIG</name></application>
                                <application><name>DNS Monitor - Resultado</name></application>
                            </applications>
                            <application_prototypes>
                                <application_prototype><name>DNS Monitor - {#DNS_DOMAIN}</name></application_prototype>
                                <application_prototype><name>DNS Monitor - {#DNS_SERVER}</name></application_prototype>
                            </application_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Qtd. Respostas</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","answers","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Numero de registros retornados na ANSWER SECTION. NOERROR com 0 respostas pode indicar anomalia ou redirecionamento indevido.</description>
                            <applications>
                                <application><name>DNS Monitor - DIG</name></application>
                                <application><name>DNS Monitor - Respostas</name></application>
                            </applications>
                            <application_prototypes>
                                <application_prototype><name>DNS Monitor - {#DNS_DOMAIN}</name></application_prototype>
                                <application_prototype><name>DNS Monitor - {#DNS_SERVER}</name></application_prototype>
                            </application_prototypes>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","answers","{$DNS_TIMEOUT_NETSTREAM}"].last()}=0 and {Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"].str(NOERROR)}=1 and {Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","answers","{$DNS_TIMEOUT_NETSTREAM}"].count(10m)}&gt;1</expression>
                                    <name>DNS DIG: {#DNS_SERVER} retornou NOERROR sem respostas para {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>WARNING</priority>
                                    <description>NOERROR com 0 respostas pode indicar redirecionamento indevido ou registro ausente.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>respostas</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <name>DNS Tempo de Resposta: {#DNS_SERVER} - {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                            <yaxismin>0.0000</yaxismin>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Template DNS Monitor - Netstream</host>
                                        <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>

                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
    <value_maps>
        <value_map>
            <name>DNS Query Status</name>
            <mappings>
                <mapping>
                    <value>0</value>
                    <newvalue>Falha</newvalue>
                </mapping>
                <mapping>
                    <value>1</value>
                    <newvalue>Sucesso</newvalue>
                </mapping>
            </mappings>
        </value_map>
    </value_maps>
</zabbix_export>
