<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>4.4</version>
    <groups>
        <group>
            <name>Templates</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template DNS Monitor - Netstream</template>
            <name>Template DNS Monitor - Netstream</name>
            <description>Netstream Telecomunicações — netstream.net.br
Contato: (11) 95990-4100 | suporte@netstream.net.br

AVISO DE PROPRIEDADE INTELECTUAL
Este template é propriedade exclusiva da Netstream Telecomunicações.
É proibida a cópia, distribuição, modificação ou qualquer uso sem
autorização prévia e por escrito da Netstream Telecomunicações.
Todos os direitos reservados.</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <macros>
                <macro>
                    <macro>{$DNS_SERVERS_NETSTREAM}</macro>
                    <value>8.8.8.8,8.8.4.4,1.1.1.1</value>
                </macro>
                <macro>
                    <macro>{$DNS_DOMAINS_NETSTREAM}</macro>
                    <value>google.com</value>
                </macro>
                <macro>
                    <macro>{$DNS_TYPES_NETSTREAM}</macro>
                    <value>A</value>
                </macro>
                <macro>
                    <macro>{$DNS_TIMEOUT_NETSTREAM}</macro>
                    <value>5</value>
                </macro>
                <macro>
                    <macro>{$DNS_WARN_TIME_NETSTREAM}</macro>
                    <value>200</value>
                </macro>
                <macro>
                    <macro>{$DNS_CRIT_TIME_NETSTREAM}</macro>
                    <value>500</value>
                </macro>
            </macros>
            <discovery_rules>
                <discovery_rule>
                    <name>Descoberta de Combinacoes DNS</name>
                    <type>EXTERNAL</type>
                    <key>netstream_dns_discover.py[&quot;{$DNS_SERVERS_NETSTREAM}&quot;,&quot;{$DNS_DOMAINS_NETSTREAM}&quot;,&quot;{$DNS_TYPES_NETSTREAM}&quot;]</key>
                    <delay>1h</delay>
                    <status>ENABLED</status>
                    <item_prototypes>
                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - RCODE</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;rcode&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>CHAR</value_type>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Resultado</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;result&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>CHAR</value_type>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Status</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;status&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UINT64</value_type>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo de Resposta</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;time&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UINT64</value_type>
                            <units>ms</units>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;time&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;].last()}&gt;{$DNS_CRIT_TIME_NETSTREAM}</expression>
                                    <name>DNS [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo critico (&gt;{$DNS_CRIT_TIME_NETSTREAM}ms)</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;dig&quot;,&quot;time&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;].last()}&gt;{$DNS_WARN_TIME_NETSTREAM}</expression>
                                    <name>DNS [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo elevado (&gt;{$DNS_WARN_TIME_NETSTREAM}ms)</name>
                                    <priority>WARNING</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>DNS NSLOOKUP [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Status</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;nslookup&quot;,&quot;status&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UINT64</value_type>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <expression>{Template DNS Monitor - Netstream:netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;nslookup&quot;,&quot;status&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;].last()}=0</expression>
                                    <name>DNS [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Falha de resolucao</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>DNS NSLOOKUP [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo de Resposta</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh[&quot;{#DNS_SERVER}&quot;,&quot;{#DNS_DOMAIN}&quot;,&quot;{#DNS_TYPE}&quot;,&quot;nslookup&quot;,&quot;time&quot;,&quot;{$DNS_TIMEOUT_NETSTREAM}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UINT64</value_type>
                            <units>ms</units>
                            <applications>
                                <application>
                                    <name>DNS</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
