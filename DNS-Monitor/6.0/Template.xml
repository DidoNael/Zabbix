<?xml version="1.0" encoding="utf-8"?>
<zabbix_export>
    <version>6.0</version>
    <date>2026-07-27T00:00:00Z</date>
    <groups>
        <group>
            <uuid>3a9400d1b2bf44a690853601386e90b3</uuid>
            <name>Templates/Network/DNS Monitor</name>
        </group>
        <group>
            <uuid>2d93b0766b5e4aef8d399801b8f11793</uuid>
            <name>NETSTREAM</name>
        </group>
    </groups>
    <templates>
        <template>
            <uuid>bd5480fa5c214dea84f8d2dc3b75a3d4</uuid>
            <template>Template DNS Monitor - Netstream</template>
            <name>Template DNS Monitor - Netstream</name>
            <description>Monitora servidores DNS via DIG com LLD.
Pre-requisitos no servidor Zabbix:
  - netstream_dns_check_netstream.sh em /usr/lib/zabbix/externalscripts/
  - netstream_dns_discover.py em /usr/lib/zabbix/externalscripts/
  - Pacotes: bind-utils (dig), python3
Compativel com: Zabbix 6.0 LTS</description>
            <groups>
                <group>
                    <name>Templates/Network/DNS Monitor</name>
                </group>
                <group>
                    <name>NETSTREAM</name>
                </group>
            </groups>
            <macros>
                <macro>
                    <macro>{$DNS_SERVERS_NETSTREAM}</macro>
                    <value>8.8.8.8,8.8.4.4,1.1.1.1</value>
                    <description>Servidores DNS a testar, separados por virgula</description>
                </macro>
                <macro>
                    <macro>{$DNS_DOMAINS_NETSTREAM}</macro>
                    <value>google.com</value>
                    <description>Dominios de referencia para teste, separados por virgula</description>
                </macro>
                <macro>
                    <macro>{$DNS_TYPES_NETSTREAM}</macro>
                    <value>A</value>
                    <description>Tipos de registro DNS, separados por virgula (A, AAAA, MX, NS...)</description>
                </macro>
                <macro>
                    <macro>{$DNS_TIMEOUT_NETSTREAM}</macro>
                    <value>5</value>
                    <description>Timeout em segundos para cada consulta DNS</description>
                </macro>
                <macro>
                    <macro>{$DNS_WARN_TIME_NETSTREAM}</macro>
                    <value>200</value>
                    <description>Limiar WARNING de tempo de resposta (ms)</description>
                </macro>
                <macro>
                    <macro>{$DNS_CRIT_TIME_NETSTREAM}</macro>
                    <value>500</value>
                    <description>Limiar CRITICAL de tempo de resposta (ms)</description>
                </macro>
            </macros>
            <valuemaps>
                <valuemap>
                    <uuid>f5b90e47fe334aa7a14633d7a62f6882</uuid>
                    <name>DNS Query Status</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Falha</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Sucesso</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
            <discovery_rules>
                <discovery_rule>
                    <uuid>40aa8896159c4c12bf0f308a7c979dd8</uuid>
                    <name>Descoberta de Combinacoes DNS</name>
                    <type>EXTERNAL</type>
                    <key>netstream_dns_discover.py["{$DNS_SERVERS_NETSTREAM}","{$DNS_DOMAINS_NETSTREAM}","{$DNS_TYPES_NETSTREAM}"]</key>
                    <delay>1h</delay>
                    <lifetime>30d</lifetime>
                    <description>Descobre combinacoes de servidor x dominio x tipo de registro a partir das macros do host.</description>
                    <item_prototypes>

                        <item_prototype>
                            <uuid>c2611dd32661447cae0fc6bcd2c21f79</uuid>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Tempo de Resposta</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60s</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <units>ms</units>
                            <description>Tempo de resposta da consulta DIG em milissegundos. Retorna 9999 em timeout.</description>
                            <tags>
                                <tag><tag>scope</tag><value>DNS</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                <tag><tag>metrica</tag><value>tempo</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>91449c887568489fba1ca1f04141ffda</uuid>
                                    <expression>last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"])>{$DNS_CRIT_TIME_NETSTREAM}</expression>
                                    <name>DNS DIG lento CRITICAL: {#DNS_SERVER} para {#DNS_DOMAIN} ({#DNS_TYPE}) &gt; {$DNS_CRIT_TIME_NETSTREAM}ms</name>
                                    <priority>HIGH</priority>
                                    <description>Tempo de resposta DIG acima do limiar CRITICAL ({$DNS_CRIT_TIME_NETSTREAM} ms).</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>tempo</value></tag>
                                    </tags>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>e60644979bd542719745572047d14e2c</uuid>
                                    <expression>last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"])&gt;{$DNS_WARN_TIME_NETSTREAM} and last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"])&lt;={$DNS_CRIT_TIME_NETSTREAM}</expression>
                                    <name>DNS DIG lento WARNING: {#DNS_SERVER} para {#DNS_DOMAIN} ({#DNS_TYPE}) &gt; {$DNS_WARN_TIME_NETSTREAM}ms</name>
                                    <priority>WARNING</priority>
                                    <description>Tempo de resposta DIG acima do limiar WARNING ({$DNS_WARN_TIME_NETSTREAM} ms).</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>tempo</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>fa555f1e3779402aabd453f73bbe7a8c</uuid>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Status</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","status","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60s</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Status da consulta DIG: 1=Sucesso, 0=Falha (sem resposta ou timeout).</description>
                            <valuemap>
                                <name>DNS Query Status</name>
                            </valuemap>
                            <tags>
                                <tag><tag>scope</tag><value>DNS</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                <tag><tag>metrica</tag><value>status</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>1c0a22ba4e264527ba99b85bae1b7151</uuid>
                                    <expression>last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","status","{$DNS_TIMEOUT_NETSTREAM}"])=0</expression>
                                    <name>DNS DIG falhou: {#DNS_SERVER} nao resolveu {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>AVERAGE</priority>
                                    <description>A consulta DIG nao retornou resposta valida.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>status</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>6879f69f6e29479cafe7877a3f324127</uuid>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - RCODE</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60s</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>CHAR</value_type>
                            <description>Codigo de resposta DNS: NOERROR, NXDOMAIN, SERVFAIL, REFUSED, TIMEOUT.</description>
                            <tags>
                                <tag><tag>scope</tag><value>DNS</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                <tag><tag>metrica</tag><value>rcode</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>7e9e788072734e5f9222c71f84e4705b</uuid>
                                    <expression>last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"])&lt;&gt;"NOERROR"</expression>
                                    <name>DNS DIG RCODE anormal: {#DNS_SERVER} retornou {ITEM.LASTVALUE} para {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>WARNING</priority>
                                    <description>O servidor DNS retornou codigo de erro diferente de NOERROR.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>rcode</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                        <item_prototype>
                            <uuid>a962195d558746ab934d405e1ecb4ead</uuid>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Resultado</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","result","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60s</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Registros retornados pelo DIG (primeiros 5, separados por virgula).</description>
                            <tags>
                                <tag><tag>scope</tag><value>DNS</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                <tag><tag>metrica</tag><value>resultado</value></tag>
                            </tags>
                        </item_prototype>

                        <item_prototype>
                            <uuid>3230122347f04531ba1635541a25b2f5</uuid>
                            <name>DNS DIG [{#DNS_SERVER}] {#DNS_DOMAIN} {#DNS_TYPE} - Qtd. Respostas</name>
                            <type>EXTERNAL</type>
                            <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","answers","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                            <delay>60s</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Numero de registros retornados na ANSWER SECTION. NOERROR com 0 respostas pode indicar anomalia ou redirecionamento indevido.</description>
                            <tags>
                                <tag><tag>scope</tag><value>DNS</value></tag>
                                <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                <tag><tag>metrica</tag><value>respostas</value></tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>9680cd1ccc834baaa9b1f3b105d0a7d7</uuid>
                                    <expression>last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","answers","{$DNS_TIMEOUT_NETSTREAM}"])=0 and last(/Template DNS Monitor - Netstream/netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","rcode","{$DNS_TIMEOUT_NETSTREAM}"])="NOERROR"</expression>
                                    <name>DNS DIG: {#DNS_SERVER} retornou NOERROR sem respostas para {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                                    <priority>WARNING</priority>
                                    <description>NOERROR com 0 respostas pode indicar redirecionamento indevido ou registro ausente.</description>
                                    <tags>
                                        <tag><tag>scope</tag><value>DNS</value></tag>
                                        <tag><tag>dominio</tag><value>{#DNS_DOMAIN}</value></tag>
                                        <tag><tag>servidor_dns</tag><value>{#DNS_SERVER}</value></tag>
                                        <tag><tag>tipo_registro</tag><value>{#DNS_TYPE}</value></tag>
                                        <tag><tag>metrica</tag><value>respostas</value></tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>

                    </item_prototypes>

                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>ba4b69c735424f8fa9c90cb4241ea827</uuid>
                            <name>DNS Tempo de Resposta: {#DNS_SERVER} - {#DNS_DOMAIN} ({#DNS_TYPE})</name>
                            <ymin_type_1>FIXED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Template DNS Monitor - Netstream</host>
                                        <key>netstream_dns_check_netstream.sh["{#DNS_SERVER}","{#DNS_DOMAIN}","{#DNS_TYPE}","dig","time","{$DNS_TIMEOUT_NETSTREAM}"]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>

                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
