#!/usr/bin/env python3
# mikrotik.cgnat.pool - conta IPs em uso em um pool nomeado do RouterOS
# Uso: mikrotik.cgnat.pool[{HOST.CONN},{$MIKROTIK_SSH_USER},{$MIKROTIK_SSH_PASS},{$CGNAT_POOL_NAME}]
import sys, subprocess, re

def main():
    if len(sys.argv) < 4:
        print(0)
        return
    host, user, password = sys.argv[1], sys.argv[2], sys.argv[3]
    pool = sys.argv[4] if len(sys.argv) > 4 else 'poolIXCCGNat'
    cmd = [
        'sshpass', '-p', password, 'ssh',
        '-o', 'StrictHostKeyChecking=no',
        '-o', 'ConnectTimeout=10',
        '-o', 'UserKnownHostsFile=/dev/null',
        '-o', 'LogLevel=ERROR',
        f'{user}@{host}',
        f'/ip pool used print count-only where pool={pool}',
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        m = re.search(r'\d+', result.stdout.strip())
        print(m.group() if m else 0)
    except Exception:
        print(0)

if __name__ == '__main__':
    main()
